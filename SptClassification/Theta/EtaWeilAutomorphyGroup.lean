module

public import SptClassification.Theta.WeilTranslations

/-!
# Inverses of generated eta–Weil automorphy data

The chosen inversion lift has order eight: its action on the upper half-plane
has order two, while its ordered square-root factor has order four. Together
with the inverse translations, this makes the generated automorphy data a
group. This is the group generated by the standard lifts; identifying it with
the usual matrix-pair presentation of `Mp₂(ℤ)` and descending the full Weil
operator remain separate tasks. See [rolenManuscript, lines 339–343].
-/

public section

namespace SptClassification
namespace Theta

/-- Inversion on the upper half-plane squares to the identity. -/
theorem EtaWeilStep.inversion_act_involution (z : UpperHalfPlane) :
    EtaWeilStep.inversion.act (EtaWeilStep.inversion.act z) = z := by
  apply UpperHalfPlane.ext
  simp only [EtaWeilStep.act_inversion, UpperHalfPlane.modular_S_smul]
  field_simp [z.ne_zero]

/-- The eta phase of the chosen inversion lift has order eight. -/
theorem etaWeilInversionPhase_pow_eight :
    EtaWeilStep.inversion.phase ^ 8 = 1 := by
  rw [EtaWeilStep.phase_inversion, eta_inversion_phase]
  calc
    Complex.exp (-(Real.pi / 4) * Complex.I) ^ 8 =
        Complex.exp (-(2 * Real.pi * Complex.I)) := by
      rw [← Complex.exp_nat_mul]
      congr 1
      ring
    _ = 1 := by
      rw [Complex.exp_neg, Complex.exp_two_pi_mul_I, inv_one]

/-- The phase of the eightfold inversion word is one. -/
theorem etaWeilInversionEight_phase_eq_one :
    etaWeilWordPhase (List.replicate 8 EtaWeilStep.inversion) = 1 := by
  have h : etaWeilWordPhase (List.replicate 8 EtaWeilStep.inversion) =
      EtaWeilStep.inversion.phase ^ 8 := by
    simp only [List.replicate_succ, etaWeilWordPhase_cons,
      etaWeilWordPhase_nil, List.replicate_zero]
    ring
  exact h.trans etaWeilInversionPhase_pow_eight

/-- Eight inversion steps represent the identity automorphy datum. -/
theorem etaWeilInversionEight_eq_identity :
    (Quotient.mk etaWeilAutomorphySetoid
      (List.replicate 8 EtaWeilStep.inversion) : EtaWeilAutomorphyWords) =
        EtaWeilAutomorphyWords.identity := by
  rw [EtaWeilAutomorphyWords.identity_eq_mk]
  apply Quotient.sound
  apply (etaWeilAutomorphySetoid_rel_iff _ _).2
  intro z
  have hact : etaWeilWordAction (List.replicate 8 EtaWeilStep.inversion) z = z := by
    simp only [List.replicate_succ, List.replicate_zero,
      etaWeilWordAction_cons, etaWeilWordAction_nil]
    rw [EtaWeilStep.inversion_act_involution,
      EtaWeilStep.inversion_act_involution,
      EtaWeilStep.inversion_act_involution,
      EtaWeilStep.inversion_act_involution]
  have hphase := etaWeilInversionEight_phase_eq_one
  constructor
  · simpa only [etaWeilWordAction_nil] using hact
  · have heta := eta_action_generator_word
        (List.replicate 8 EtaWeilStep.inversion) z
    rw [hact, hphase] at heta
    simp only [one_mul] at heta
    have hn := ModularForm.eta_ne_zero z.im_pos
    apply (mul_right_cancel₀ hn)
    simpa only [etaWeilWordFactor_nil, one_mul] using heta.symm

/-- The generator inversion has a two-sided inverse represented by seven
further inversion steps. -/
theorem EtaWeilAutomorphyWords.inversion_inverse :
    let s : EtaWeilAutomorphyWords :=
      Quotient.mk etaWeilAutomorphySetoid [EtaWeilStep.inversion]
    let sInv : EtaWeilAutomorphyWords :=
      Quotient.mk etaWeilAutomorphySetoid
        (List.replicate 7 EtaWeilStep.inversion)
    s.compose sInv = identity ∧ sInv.compose s = identity := by
  dsimp
  constructor
  · rw [EtaWeilAutomorphyWords.compose_mk]
    exact etaWeilInversionEight_eq_identity
  · rw [EtaWeilAutomorphyWords.compose_mk]
    exact etaWeilInversionEight_eq_identity

/-- Each standard generator has a two-sided inverse in the automorphy data. -/
theorem EtaWeilStep.exists_automorphy_inverse (g : EtaWeilStep) :
    ∃ h : EtaWeilAutomorphyWords,
      EtaWeilAutomorphyWords.compose
        (Quotient.mk etaWeilAutomorphySetoid [g]) h =
        EtaWeilAutomorphyWords.identity ∧
      h.compose (Quotient.mk etaWeilAutomorphySetoid [g] : EtaWeilAutomorphyWords) =
        EtaWeilAutomorphyWords.identity := by
  cases g with
  | inversion =>
      exact ⟨Quotient.mk etaWeilAutomorphySetoid
        (List.replicate 7 EtaWeilStep.inversion),
        EtaWeilAutomorphyWords.inversion_inverse⟩
  | translation n =>
      exact ⟨EtaWeilAutomorphyWords.translation (-n),
        by simpa only [EtaWeilAutomorphyWords.translation_eq_mk] using
          (EtaWeilAutomorphyWords.translation_inverse n).1,
        by simpa only [EtaWeilAutomorphyWords.translation_eq_mk] using
          (EtaWeilAutomorphyWords.translation_inverse n).2⟩

/-- Every generated automorphy datum has a two-sided inverse. -/
theorem EtaWeilAutomorphyWords.exists_inverse (g : EtaWeilAutomorphyWords) :
    ∃ h : EtaWeilAutomorphyWords,
      g.compose h = identity ∧ h.compose g = identity := by
  induction g using Quotient.inductionOn with
  | h w =>
      induction w with
      | nil =>
          refine ⟨identity, ?_, ?_⟩
          · rw [← identity_eq_mk]
            exact identity_compose identity
          · rw [← identity_eq_mk]
            exact compose_identity identity
      | cons step tail ih =>
          obtain ⟨tailInv, htail, htail'⟩ := ih
          obtain ⟨stepInv, hstep, hstep'⟩ :=
            EtaWeilStep.exists_automorphy_inverse step
          let stepData : EtaWeilAutomorphyWords :=
            Quotient.mk etaWeilAutomorphySetoid [step]
          let tailData : EtaWeilAutomorphyWords :=
            Quotient.mk etaWeilAutomorphySetoid tail
          have hword :
              (Quotient.mk etaWeilAutomorphySetoid (step :: tail) :
                EtaWeilAutomorphyWords) = stepData.compose tailData := by
            dsimp [stepData, tailData]
            rw [compose_mk]
            rfl
          rw [hword]
          refine ⟨tailInv.compose stepInv, ?_, ?_⟩
          · rw [compose_assoc, ← compose_assoc tailData, htail]
            rw [identity_compose, hstep]
          · rw [compose_assoc, ← compose_assoc stepInv,
              hstep', identity_compose, htail']

/-- The automorphy data generated by the standard eta–Weil lifts form a group. -/
noncomputable instance : Group EtaWeilAutomorphyWords where
  inv g := Classical.choose (EtaWeilAutomorphyWords.exists_inverse g)
  inv_mul_cancel g := (Classical.choose_spec
    (EtaWeilAutomorphyWords.exists_inverse g)).2

end Theta
