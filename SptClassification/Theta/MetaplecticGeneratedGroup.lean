module

public import SptClassification.Theta.WeilCentralRelations
public import SptClassification.Theta.MetaplecticKernel

/-!
# The group generated by the standard metaplectic lifts

The standard inversion lift has order eight as a concrete matrix–factor pair,
and integral translations have inverse translations. These facts identify the
word-generated submonoid as a subgroup of algebraic metaplectic pairs. They do
not by themselves descend the full finite Weil operator. See
[rolenManuscript, lines 339–343].
-/

public section

namespace SptClassification
namespace Theta

/-- Eight copies of the standard inversion have identity integral matrix. -/
theorem etaWeilInversionEight_matrix_eq_one :
    etaWeilWordMatrix (List.replicate 8 EtaWeilStep.inversion) = 1 := by
  have h : List.replicate 8 EtaWeilStep.inversion =
      List.replicate 4 EtaWeilStep.inversion ++
        List.replicate 4 EtaWeilStep.inversion := (rfl)
  rw [h, etaWeilWordMatrix_append, etaWeilInversionFour_matrix_eq_one, one_mul]

/-- Eight copies of the standard inversion give the neutral concrete pair. -/
theorem etaWeilInversionEight_pair_eq_one :
    etaWeilWordMetaplecticPair (List.replicate 8 EtaWeilStep.inversion) = 1 := by
  apply MetaplecticPair.ext
  · simpa only [etaWeilWordMetaplecticPair_matrix,
      MetaplecticPair.one_eq_identity, MetaplecticPair.identity_matrix] using
      etaWeilInversionEight_matrix_eq_one
  · funext z
    simp only [etaWeilWordMetaplecticPair_factor,
      MetaplecticPair.one_eq_identity, MetaplecticPair.identity_factor,
      etaWeilWordFactor_of_matrix_one _ etaWeilInversionEight_matrix_eq_one,
      etaWeilInversionEight_phase_eq_one, inv_one]

/-- Concrete translation pairs compose by addition of their parameters. -/
theorem etaWeilTranslationPair_add (m n : ℤ) :
    (EtaWeilStep.translation m).metaplecticPair *
        (EtaWeilStep.translation n).metaplecticPair =
      (EtaWeilStep.translation (m + n)).metaplecticPair := by
  apply MetaplecticPair.ext
  · simp only [MetaplecticPair.mul_matrix, EtaWeilStep.metaplecticPair_matrix]
    change (EtaWeilStep.translation m).matrix *
        (EtaWeilStep.translation n).matrix =
      (EtaWeilStep.translation (m + n)).matrix
    ext i j
    simp only [Matrix.SpecialLinearGroup.coe_mul]
    fin_cases i <;> fin_cases j <;>
      norm_num [EtaWeilStep.matrix_translation_apply,
        Matrix.mul_apply, Fin.sum_univ_two]; ring
  · funext z
    simp only [MetaplecticPair.mul_factor, EtaWeilStep.metaplecticPair_matrix,
      EtaWeilStep.metaplecticPair_factor]
    change (EtaWeilStep.translation m).factor
      ((EtaWeilStep.translation n).matrix • z) *
        (EtaWeilStep.translation n).factor z =
      (EtaWeilStep.translation (m + n)).factor z
    simp only [EtaWeilStep.factor_translation, one_mul]

/-- Translation by the negative integer is the inverse concrete pair. -/
theorem etaWeilTranslationPair_inv (n : ℤ) :
    (EtaWeilStep.translation n).metaplecticPair⁻¹ =
      (EtaWeilStep.translation (-n)).metaplecticPair := by
  have h : (EtaWeilStep.translation n).metaplecticPair *
      (EtaWeilStep.translation (-n)).metaplecticPair = 1 := by
    rw [etaWeilTranslationPair_add, add_neg_cancel]
    apply MetaplecticPair.ext
    · simp only [EtaWeilStep.metaplecticPair_matrix,
        MetaplecticPair.one_eq_identity, MetaplecticPair.identity_matrix,
        EtaWeilStep.matrix_translation_zero]
    · funext z
      simp only [EtaWeilStep.metaplecticPair_factor,
        MetaplecticPair.one_eq_identity, MetaplecticPair.identity_factor,
        EtaWeilStep.factor_translation]
  calc
    (EtaWeilStep.translation n).metaplecticPair⁻¹ =
        (EtaWeilStep.translation n).metaplecticPair⁻¹ *
          ((EtaWeilStep.translation n).metaplecticPair *
            (EtaWeilStep.translation (-n)).metaplecticPair) := by rw [h, mul_one]
    _ = (EtaWeilStep.translation (-n)).metaplecticPair := by
      rw [← mul_assoc, inv_mul_cancel, one_mul]

/-- A singleton word represents exactly its chosen generator pair. -/
theorem etaWeilWordMetaplecticPair_singleton (g : EtaWeilStep) :
    etaWeilWordMetaplecticPair [g] = g.metaplecticPair := by
  apply MetaplecticPair.ext
  · simp only [etaWeilWordMetaplecticPair_matrix, etaWeilWordMatrix_cons,
      etaWeilWordMatrix_nil, mul_one, EtaWeilStep.metaplecticPair_matrix]
  · funext z
    simp only [etaWeilWordMetaplecticPair_factor, etaWeilWordFactor_cons,
      etaWeilWordAction_nil, etaWeilWordFactor_nil, mul_one,
      EtaWeilStep.metaplecticPair_factor]

/-- Seven further inversion lifts represent the inverse of the chosen one. -/
theorem etaWeilInversionPair_inv :
    EtaWeilStep.inversion.metaplecticPair⁻¹ =
      etaWeilWordMetaplecticPair (List.replicate 7 EtaWeilStep.inversion) := by
  have hword : etaWeilWordMetaplecticPair
      ([EtaWeilStep.inversion] ++ List.replicate 7 EtaWeilStep.inversion) = 1 := by
    simpa only [List.singleton_append, List.replicate_succ] using
      etaWeilInversionEight_pair_eq_one
  rw [etaWeilWordMetaplecticPair_append,
    etaWeilWordMetaplecticPair_singleton] at hword
  change EtaWeilStep.inversion.metaplecticPair *
    etaWeilWordMetaplecticPair
      (List.replicate 7 EtaWeilStep.inversion) = 1 at hword
  calc
    EtaWeilStep.inversion.metaplecticPair⁻¹ =
        EtaWeilStep.inversion.metaplecticPair⁻¹ *
          (EtaWeilStep.inversion.metaplecticPair *
            etaWeilWordMetaplecticPair
              (List.replicate 7 EtaWeilStep.inversion)) := by
                rw [hword, mul_one]
    _ = etaWeilWordMetaplecticPair
          (List.replicate 7 EtaWeilStep.inversion) := by
            rw [← mul_assoc, inv_mul_cancel, one_mul]

/-- Every standard generator has its inverse in the concrete word image. -/
theorem etaWeilStep_pair_inv_mem (g : EtaWeilStep) :
    g.metaplecticPair⁻¹ ∈ etaWeilGeneratedPairs := by
  cases g with
  | inversion =>
      rw [etaWeilInversionPair_inv]
      exact etaWeilWordMetaplecticPair_mem_generated _
  | translation n =>
      rw [etaWeilTranslationPair_inv,
        ← etaWeilWordMetaplecticPair_singleton]
      exact etaWeilWordMetaplecticPair_mem_generated _

/-- The concrete word image is closed under inverses. -/
theorem etaWeilGeneratedPairs_inv_mem (g : MetaplecticPair)
    (hg : g ∈ etaWeilGeneratedPairs) : g⁻¹ ∈ etaWeilGeneratedPairs := by
  rw [mem_etaWeilGeneratedPairs_iff] at hg
  rcases hg with ⟨w, rfl⟩
  induction w with
  | nil =>
      have hnil : etaWeilWordMetaplecticPair [] = 1 := by
        simpa only [MetaplecticPair.one_eq_identity] using
          etaWeilWordMetaplecticPair_nil
      rw [hnil, inv_one]
      exact etaWeilGeneratedPairs.one_mem
  | cons step tail ih =>
      have hsplit : etaWeilWordMetaplecticPair (step :: tail) =
          step.metaplecticPair * etaWeilWordMetaplecticPair tail := by
        calc
          etaWeilWordMetaplecticPair (step :: tail) =
              etaWeilWordMetaplecticPair ([step] ++ tail) := rfl
          _ = etaWeilWordMetaplecticPair [step] *
              etaWeilWordMetaplecticPair tail :=
                etaWeilWordMetaplecticPair_append [step] tail
          _ = step.metaplecticPair * etaWeilWordMetaplecticPair tail := by
                rw [etaWeilWordMetaplecticPair_singleton]
      rw [hsplit, mul_inv_rev]
      exact etaWeilGeneratedPairs.mul_mem ih (etaWeilStep_pair_inv_mem step)

/-- The standard matrix–factor pairs generated by inversion and integral
translations form a subgroup. -/
noncomputable def etaWeilGeneratedSubgroup : Subgroup MetaplecticPair where
  carrier := etaWeilGeneratedPairs
  one_mem' := etaWeilGeneratedPairs.one_mem
  mul_mem' := etaWeilGeneratedPairs.mul_mem
  inv_mem' := by
    intro g hg
    exact etaWeilGeneratedPairs_inv_mem g hg

theorem mem_etaWeilGeneratedSubgroup_iff (g : MetaplecticPair) :
    g ∈ etaWeilGeneratedSubgroup ↔ g ∈ etaWeilGeneratedPairs := Iff.rfl

end Theta
