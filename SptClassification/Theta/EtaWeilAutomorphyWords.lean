module

public import SptClassification.Theta.EtaWeilGeneratorWords

/-!
# Automorphy data of eta–Weil generator words

Two standard-generator words represent the same automorphy data when they act
identically on the upper half-plane and have the same ordered square-root
factor. Eta nonvanishing makes the eigenvalue of the distinguished finite
Weil line descend to this quotient. The quotient is the generated automorphy
data; its identification with the standard metaplectic group and descent of
the full finite Weil operator are further obligations. See
[rolenManuscript, lines 339–343].
-/

public section

namespace SptClassification
namespace Theta

/-- Applying two generator words means applying the right word first. -/
theorem etaWeilWordAction_append (w v : List EtaWeilStep)
    (z : UpperHalfPlane) :
    etaWeilWordAction (w ++ v) z =
      etaWeilWordAction w (etaWeilWordAction v z) := by
  induction w with
  | nil => simp only [List.nil_append, etaWeilWordAction_nil]
  | cons g w ih =>
      simpa only [List.cons_append, etaWeilWordAction_cons] using congrArg g.act ih

/-- The ordered square roots obey the automorphy-factor cocycle. -/
theorem etaWeilWordFactor_append (w v : List EtaWeilStep)
    (z : UpperHalfPlane) :
    etaWeilWordFactor (w ++ v) z =
      etaWeilWordFactor w (etaWeilWordAction v z) *
        etaWeilWordFactor v z := by
  induction w with
  | nil => simp only [List.nil_append, etaWeilWordFactor_nil, one_mul]
  | cons g w ih =>
      simp only [List.cons_append, etaWeilWordFactor_cons]
      rw [etaWeilWordAction_append, ih]
      ring

theorem etaWeilWordPhase_append (w v : List EtaWeilStep) :
    etaWeilWordPhase (w ++ v) = etaWeilWordPhase w * etaWeilWordPhase v := by
  induction w with
  | nil => simp only [List.nil_append, etaWeilWordPhase_nil, one_mul]
  | cons g w ih =>
      simp only [List.cons_append, etaWeilWordPhase_cons, ih, mul_assoc]

/-- Equality of the action and square-root factor attached to two words. -/
def etaWeilAutomorphySetoid : Setoid (List EtaWeilStep) where
  r w w' := ∀ z : UpperHalfPlane,
    etaWeilWordAction w z = etaWeilWordAction w' z ∧
      etaWeilWordFactor w z = etaWeilWordFactor w' z
  iseqv := ⟨
    by intro w z; exact ⟨rfl, rfl⟩,
    by
      intro w w' h z
      exact ⟨(h z).1.symm, (h z).2.symm⟩,
    by
      intro w w' w'' h h' z
      exact ⟨(h z).1.trans (h' z).1, (h z).2.trans (h' z).2⟩⟩

theorem etaWeilAutomorphySetoid_rel_iff (w v : List EtaWeilStep) :
    etaWeilAutomorphySetoid.r w v ↔
      ∀ z : UpperHalfPlane,
        etaWeilWordAction w z = etaWeilWordAction v z ∧
          etaWeilWordFactor w z = etaWeilWordFactor v z :=
  Iff.rfl

theorem etaWeilAutomorphySetoid_append_congr
    (w w' v v' : List EtaWeilStep)
    (hw : etaWeilAutomorphySetoid.r w w')
    (hv : etaWeilAutomorphySetoid.r v v') :
    etaWeilAutomorphySetoid.r (w ++ v) (w' ++ v') := by
  intro z
  constructor
  · rw [etaWeilWordAction_append, etaWeilWordAction_append,
      (hv z).1, (hw (etaWeilWordAction v' z)).1]
  · rw [etaWeilWordFactor_append, etaWeilWordFactor_append,
      (hv z).1, (hv z).2, (hw (etaWeilWordAction v' z)).2]

/-- Automorphy data generated by inversion and integral translations. -/
@[expose] def EtaWeilAutomorphyWords := Quotient etaWeilAutomorphySetoid

/-- Composition in the generated automorphy data. -/
noncomputable def EtaWeilAutomorphyWords.compose
    (g h : EtaWeilAutomorphyWords) : EtaWeilAutomorphyWords :=
  Quotient.liftOn₂ g h
    (fun w v => Quotient.mk etaWeilAutomorphySetoid (w ++ v))
    (by
      intro w v w' v' hw hv
      exact Quotient.sound (etaWeilAutomorphySetoid_append_congr w w' v v' hw hv))

theorem EtaWeilAutomorphyWords.compose_mk (w v : List EtaWeilStep) :
    EtaWeilAutomorphyWords.compose
        (Quotient.mk etaWeilAutomorphySetoid w)
        (Quotient.mk etaWeilAutomorphySetoid v) =
      Quotient.mk etaWeilAutomorphySetoid (w ++ v) := (rfl)

/-- The empty word is the identity automorphy datum. -/
def EtaWeilAutomorphyWords.identity : EtaWeilAutomorphyWords :=
  Quotient.mk etaWeilAutomorphySetoid []

theorem EtaWeilAutomorphyWords.identity_eq_mk :
    EtaWeilAutomorphyWords.identity = Quotient.mk etaWeilAutomorphySetoid [] :=
  (rfl)

theorem EtaWeilAutomorphyWords.compose_assoc
    (g h k : EtaWeilAutomorphyWords) :
    (g.compose h).compose k = g.compose (h.compose k) := by
  induction g using Quotient.inductionOn with
  | h w =>
      induction h using Quotient.inductionOn with
      | h v =>
          induction k using Quotient.inductionOn with
          | h u =>
              simp only [EtaWeilAutomorphyWords.compose_mk]
              exact congrArg (Quotient.mk etaWeilAutomorphySetoid)
                (List.append_assoc w v u)

theorem EtaWeilAutomorphyWords.identity_compose
    (g : EtaWeilAutomorphyWords) : identity.compose g = g := by
  induction g using Quotient.inductionOn with
  | h w =>
      change EtaWeilAutomorphyWords.compose
          (Quotient.mk etaWeilAutomorphySetoid [])
          (Quotient.mk etaWeilAutomorphySetoid w) =
        Quotient.mk etaWeilAutomorphySetoid w
      calc
        _ = Quotient.mk etaWeilAutomorphySetoid ([] ++ w) :=
          EtaWeilAutomorphyWords.compose_mk [] w
        _ = Quotient.mk etaWeilAutomorphySetoid w :=
          congrArg (Quotient.mk etaWeilAutomorphySetoid) (List.nil_append w)

theorem EtaWeilAutomorphyWords.compose_identity
    (g : EtaWeilAutomorphyWords) : g.compose identity = g := by
  induction g using Quotient.inductionOn with
  | h w =>
      change Quotient.mk etaWeilAutomorphySetoid (w ++ []) =
        Quotient.mk etaWeilAutomorphySetoid w
      simp only [List.append_nil]

noncomputable instance : Monoid EtaWeilAutomorphyWords where
  mul := EtaWeilAutomorphyWords.compose
  one := EtaWeilAutomorphyWords.identity
  mul_assoc := EtaWeilAutomorphyWords.compose_assoc
  one_mul := EtaWeilAutomorphyWords.identity_compose
  mul_one := EtaWeilAutomorphyWords.compose_identity

/-- The eta eigenvalue depends only on automorphy data. -/
noncomputable def EtaWeilAutomorphyWords.phase : EtaWeilAutomorphyWords → ℂ :=
  Quotient.lift etaWeilWordPhase (by
    intro w w' h
    let z : UpperHalfPlane := ⟨Complex.I, by simp⟩
    exact etaWeilWordPhase_eq_of_action_factor_eq w w' z (h z).1 (h z).2)

theorem EtaWeilAutomorphyWords.phase_mk (w : List EtaWeilStep) :
    EtaWeilAutomorphyWords.phase (Quotient.mk etaWeilAutomorphySetoid w) =
      etaWeilWordPhase w := (rfl)

theorem EtaWeilAutomorphyWords.phase_compose
    (g h : EtaWeilAutomorphyWords) :
    (g.compose h).phase = g.phase * h.phase := by
  induction g using Quotient.inductionOn with
  | h w =>
      induction h using Quotient.inductionOn with
      | h v =>
          simpa only [EtaWeilAutomorphyWords.compose_mk,
            EtaWeilAutomorphyWords.phase_mk] using etaWeilWordPhase_append w v

/-- The eta multiplier on the generated automorphy-data monoid. -/
noncomputable def etaWeilAutomorphyCharacter : EtaWeilAutomorphyWords →* ℂ where
  toFun := EtaWeilAutomorphyWords.phase
  map_one' := by
    change EtaWeilAutomorphyWords.phase EtaWeilAutomorphyWords.identity = 1
    simp only [EtaWeilAutomorphyWords.identity, EtaWeilAutomorphyWords.phase_mk,
      etaWeilWordPhase_nil]
  map_mul' := by
    intro g h
    change (g.compose h).phase = g.phase * h.phase
    exact EtaWeilAutomorphyWords.phase_compose g h

/-- The induced action on the distinguished input line. -/
noncomputable def EtaWeilAutomorphyWords.inputAction (g : EtaWeilAutomorphyWords) :
    ZMod 12 → ℂ := fun r => g.phase * weilInputVectorAs ℂ r

@[simp] theorem EtaWeilAutomorphyWords.inputAction_apply
    (g : EtaWeilAutomorphyWords) (r : ZMod 12) :
    g.inputAction r = g.phase * weilInputVectorAs ℂ r := (rfl)

theorem EtaWeilAutomorphyWords.inputAction_mk (w : List EtaWeilStep) :
    EtaWeilAutomorphyWords.inputAction
        (Quotient.mk etaWeilAutomorphySetoid w) =
      etaWeilWordFiniteAction w (weilInputVectorAs ℂ) := by
  calc
    _ = (fun r => etaWeilWordPhase w * weilInputVectorAs ℂ r) := by
      funext r
      exact (EtaWeilAutomorphyWords.inputAction_apply _ r).trans
        (congrArg (fun c : ℂ => c * weilInputVectorAs ℂ r)
          (EtaWeilAutomorphyWords.phase_mk w))
    _ = _ := (etaWeilWordFiniteAction_input w).symm

end Theta
end SptClassification
