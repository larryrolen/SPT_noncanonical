module

public import SptClassification.Theta.MetaplecticWords

/-!
# Algebraic metaplectic pairs generated by inversion and translations

A pair records its integral determinant-one matrix and an everywhere nonzero
square root of the denominator. The square-root convention is the one used in
[rolenManuscript, lines 339–343]. The word construction below produces
concrete pairs; a full finite Weil operator on equal pairs still requires a
descent theorem.
-/

public section

namespace SptClassification
namespace Theta

/-- An algebraic metaplectic pair over the upper half-plane. -/
structure MetaplecticPair where
  matrix : Matrix.SpecialLinearGroup (Fin 2) ℤ
  factor : UpperHalfPlane → ℂ
  factor_sq : ∀ z, factor z ^ 2 = metaplecticDenominator matrix z
  factor_ne_zero : ∀ z, factor z ≠ 0

/-- Composition of metaplectic pairs, applying the right-hand pair first. -/
noncomputable def MetaplecticPair.comp (g h : MetaplecticPair) : MetaplecticPair where
  matrix := g.matrix * h.matrix
  factor z := g.factor (h.matrix • z) * h.factor z
  factor_sq z := by
    rw [mul_pow, g.factor_sq, h.factor_sq]
    symm
    exact metaplecticDenominator_mul g.matrix h.matrix z
      (by rw [← h.factor_sq]; exact pow_ne_zero _ (h.factor_ne_zero z))
  factor_ne_zero z := mul_ne_zero (g.factor_ne_zero _) (h.factor_ne_zero z)

@[simp] theorem MetaplecticPair.comp_matrix (g h : MetaplecticPair) :
    (g.comp h).matrix = g.matrix * h.matrix := (rfl)

@[simp] theorem MetaplecticPair.comp_factor (g h : MetaplecticPair)
    (z : UpperHalfPlane) :
    (g.comp h).factor z = g.factor (h.matrix • z) * h.factor z := (rfl)

/-- The neutral integral matrix with constant square-root factor one. -/
def MetaplecticPair.identity : MetaplecticPair where
  matrix := 1
  factor _ := 1
  factor_sq z := by simp only [metaplecticDenominator_one, one_pow]
  factor_ne_zero _ := one_ne_zero

@[simp] theorem MetaplecticPair.identity_matrix : identity.matrix = 1 := (rfl)

@[simp] theorem MetaplecticPair.identity_factor (z : UpperHalfPlane) :
    identity.factor z = 1 := (rfl)

theorem MetaplecticPair.ext (g h : MetaplecticPair)
    (hmatrix : g.matrix = h.matrix) (hfactor : g.factor = h.factor) : g = h := by
  cases g
  cases h
  cases hmatrix
  cases hfactor
  rfl

/-- Composition of algebraic metaplectic pairs is associative. -/
theorem MetaplecticPair.comp_assoc (g h k : MetaplecticPair) :
    (g.comp h).comp k = g.comp (h.comp k) := by
  apply MetaplecticPair.ext
  · simp [MetaplecticPair.comp, mul_assoc]
  · funext z
    simp only [MetaplecticPair.comp, mul_smul]
    ring

theorem MetaplecticPair.identity_comp (g : MetaplecticPair) :
    identity.comp g = g := by
  apply MetaplecticPair.ext
  · simp [MetaplecticPair.comp, MetaplecticPair.identity]
  · funext z
    simp [MetaplecticPair.comp, MetaplecticPair.identity]

theorem MetaplecticPair.comp_identity (g : MetaplecticPair) :
    g.comp identity = g := by
  apply MetaplecticPair.ext
  · simp [MetaplecticPair.comp, MetaplecticPair.identity]
  · funext z
    simp [MetaplecticPair.comp, MetaplecticPair.identity]

/-- Algebraic metaplectic pairs form a monoid under the denominator cocycle. -/
noncomputable instance : Monoid MetaplecticPair where
  mul := MetaplecticPair.comp
  mul_assoc := MetaplecticPair.comp_assoc
  one := MetaplecticPair.identity
  one_mul := MetaplecticPair.identity_comp
  mul_one := MetaplecticPair.comp_identity

@[simp] theorem MetaplecticPair.mul_matrix (g h : MetaplecticPair) :
    (g * h).matrix = g.matrix * h.matrix :=
  MetaplecticPair.comp_matrix g h

@[simp] theorem MetaplecticPair.mul_factor (g h : MetaplecticPair)
    (z : UpperHalfPlane) :
    (g * h).factor z = g.factor (h.matrix • z) * h.factor z :=
  MetaplecticPair.comp_factor g h z

@[simp] theorem MetaplecticPair.one_eq_identity :
    (1 : MetaplecticPair) = identity := (rfl)

/-- The chosen metaplectic pair for a standard generator. -/
noncomputable def EtaWeilStep.metaplecticPair (g : EtaWeilStep) : MetaplecticPair where
  matrix := g.matrix
  factor := g.factor
  factor_sq := g.factor_sq
  factor_ne_zero := g.factor_ne_zero

@[simp] theorem EtaWeilStep.metaplecticPair_matrix (g : EtaWeilStep) :
    g.metaplecticPair.matrix = g.matrix := (rfl)

@[simp] theorem EtaWeilStep.metaplecticPair_factor (g : EtaWeilStep)
    (z : UpperHalfPlane) : g.metaplecticPair.factor z = g.factor z := (rfl)

/-- The concrete metaplectic pair produced by a generator word. -/
noncomputable def etaWeilWordMetaplecticPair (w : List EtaWeilStep) :
    MetaplecticPair where
  matrix := etaWeilWordMatrix w
  factor := etaWeilWordFactor w
  factor_sq := etaWeilWordFactor_sq w
  factor_ne_zero := etaWeilWordFactor_ne_zero w

@[simp] theorem etaWeilWordMetaplecticPair_matrix (w : List EtaWeilStep) :
    (etaWeilWordMetaplecticPair w).matrix = etaWeilWordMatrix w := (rfl)

@[simp] theorem etaWeilWordMetaplecticPair_factor (w : List EtaWeilStep)
    (z : UpperHalfPlane) :
    (etaWeilWordMetaplecticPair w).factor z = etaWeilWordFactor w z := (rfl)

theorem etaWeilWordMetaplecticPair_nil :
    etaWeilWordMetaplecticPair [] = MetaplecticPair.identity := by
  apply MetaplecticPair.ext
  · simp only [etaWeilWordMetaplecticPair_matrix, etaWeilWordMatrix_nil,
      MetaplecticPair.identity_matrix]
  · funext z
    simp only [etaWeilWordMetaplecticPair_factor, etaWeilWordFactor_nil,
      MetaplecticPair.identity_factor]

/-- Matrix multiplication follows concatenation of generator words. -/
theorem etaWeilWordMatrix_append (w v : List EtaWeilStep) :
    etaWeilWordMatrix (w ++ v) =
      etaWeilWordMatrix w * etaWeilWordMatrix v := by
  induction w with
  | nil => simp only [List.nil_append, etaWeilWordMatrix_nil, one_mul]
  | cons g w ih =>
      simp only [List.cons_append, etaWeilWordMatrix_cons, ih]
      rw [mul_assoc]

/-- The concrete pair of a concatenation is the composition of its pairs. -/
theorem etaWeilWordMetaplecticPair_append (w v : List EtaWeilStep) :
    etaWeilWordMetaplecticPair (w ++ v) =
      (etaWeilWordMetaplecticPair w).comp
        (etaWeilWordMetaplecticPair v) := by
  apply MetaplecticPair.ext
  · exact etaWeilWordMatrix_append w v
  · funext z
    simpa only [etaWeilWordMetaplecticPair_factor, MetaplecticPair.comp_factor,
      etaWeilWordMetaplecticPair_matrix, etaWeilWordMatrix_smul] using
      etaWeilWordFactor_append w v z

/-- Equal concrete pairs give equal eta scalars on the distinguished finite
Weil input line. -/
theorem etaWeilWordPhase_eq_of_metaplecticPair_eq
    (w w' : List EtaWeilStep)
    (h : etaWeilWordMetaplecticPair w = etaWeilWordMetaplecticPair w') :
    etaWeilWordPhase w = etaWeilWordPhase w' := by
  have hmatrix : etaWeilWordMatrix w = etaWeilWordMatrix w' :=
    congrArg MetaplecticPair.matrix h
  have hfactor : etaWeilWordFactor w = etaWeilWordFactor w' :=
    congrArg MetaplecticPair.factor h
  exact etaWeilWordPhase_eq_of_action_factor_eq w w' (UpperHalfPlane.I)
    (by rw [← etaWeilWordMatrix_smul, ← etaWeilWordMatrix_smul, hmatrix])
    (congrFun hfactor _)

/-- Concrete pairs generated by the standard inversion and integral
translations, represented by generator words. -/
noncomputable def etaWeilGeneratedPairs : Submonoid MetaplecticPair where
  carrier := Set.range etaWeilWordMetaplecticPair
  one_mem' := by
    refine ⟨[], ?_⟩
    apply MetaplecticPair.ext
    · simp only [etaWeilWordMetaplecticPair_matrix,
        etaWeilWordMatrix_nil, MetaplecticPair.identity_matrix]
      rfl
    · funext z
      simp only [etaWeilWordMetaplecticPair_factor,
        etaWeilWordFactor_nil, MetaplecticPair.one_eq_identity,
        MetaplecticPair.identity_factor]
  mul_mem' := by
    rintro _ _ ⟨w, rfl⟩ ⟨v, rfl⟩
    exact ⟨w ++ v, etaWeilWordMetaplecticPair_append w v⟩

theorem mem_etaWeilGeneratedPairs_iff (g : MetaplecticPair) :
    g ∈ etaWeilGeneratedPairs ↔
      ∃ w : List EtaWeilStep, etaWeilWordMetaplecticPair w = g := Iff.rfl

theorem etaWeilWordMetaplecticPair_mem_generated (w : List EtaWeilStep) :
    etaWeilWordMetaplecticPair w ∈ etaWeilGeneratedPairs := by
  change etaWeilWordMetaplecticPair w ∈ Set.range etaWeilWordMetaplecticPair
  exact Set.mem_range_self w

/-- A chosen generator word for a concrete generated metaplectic pair. -/
noncomputable def generatedPairWord
    (g : etaWeilGeneratedPairs) : List EtaWeilStep :=
  Classical.choose (Set.mem_range.mp g.property)

theorem generatedPairWord_eq (g : etaWeilGeneratedPairs) :
    etaWeilWordMetaplecticPair (generatedPairWord g) = g.val :=
  Classical.choose_spec (Set.mem_range.mp g.property)

/-- The eta eigenvalue is well defined on a concrete generated metaplectic
pair, independently of the chosen word. -/
noncomputable def generatedPairPhase (g : etaWeilGeneratedPairs) : ℂ :=
  etaWeilWordPhase (generatedPairWord g)

theorem generatedPairPhase_eq (g : etaWeilGeneratedPairs) :
    generatedPairPhase g = etaWeilWordPhase (generatedPairWord g) := (rfl)

theorem generatedPairPhase_word (w : List EtaWeilStep) :
    generatedPairPhase ⟨etaWeilWordMetaplecticPair w,
      etaWeilWordMetaplecticPair_mem_generated w⟩ =
      etaWeilWordPhase w := by
  unfold generatedPairPhase
  exact etaWeilWordPhase_eq_of_metaplecticPair_eq _ w
    (generatedPairWord_eq _)

theorem generatedPairPhase_one :
    generatedPairPhase (1 : etaWeilGeneratedPairs) = 1 := by
  unfold generatedPairPhase
  have hpair : etaWeilWordMetaplecticPair
      (generatedPairWord (1 : etaWeilGeneratedPairs)) =
      etaWeilWordMetaplecticPair [] := by
    rw [generatedPairWord_eq]
    change (1 : MetaplecticPair) = etaWeilWordMetaplecticPair []
    exact MetaplecticPair.one_eq_identity.trans etaWeilWordMetaplecticPair_nil.symm
  have hphase := etaWeilWordPhase_eq_of_metaplecticPair_eq _ [] hpair
  simpa only [etaWeilWordPhase_nil] using hphase

/-- The eta scalar on generated concrete pairs respects composition. -/
theorem generatedPairPhase_mul (g h : etaWeilGeneratedPairs) :
    generatedPairPhase (g * h) =
      generatedPairPhase g * generatedPairPhase h := by
  unfold generatedPairPhase
  have hpair : etaWeilWordMetaplecticPair (generatedPairWord (g * h)) =
      etaWeilWordMetaplecticPair (generatedPairWord g ++ generatedPairWord h) := by
    rw [generatedPairWord_eq, etaWeilWordMetaplecticPair_append,
      generatedPairWord_eq, generatedPairWord_eq]
    rfl
  exact (etaWeilWordPhase_eq_of_metaplecticPair_eq _ _ hpair).trans
    (etaWeilWordPhase_append _ _)

theorem etaWeilWordPhase_ne_zero (w : List EtaWeilStep) :
    etaWeilWordPhase w ≠ 0 := by
  have h := eta_action_generator_word w UpperHalfPlane.I
  intro hz
  rw [hz] at h
  simp only [zero_mul] at h
  exact (ModularForm.eta_ne_zero (etaWeilWordAction w UpperHalfPlane.I).im_pos) h

theorem generatedPairPhase_ne_zero (g : etaWeilGeneratedPairs) :
    generatedPairPhase g ≠ 0 :=
  etaWeilWordPhase_ne_zero (generatedPairWord g)

/-- The eta multiplier on the concrete monoid of generated matrix–factor
pairs. The full finite Weil operator is not yet descended to this monoid. -/
noncomputable def generatedPairEtaCharacter : etaWeilGeneratedPairs →* ℂˣ where
  toFun g := Units.mk0 (generatedPairPhase g) (generatedPairPhase_ne_zero g)
  map_one' := by
    apply Units.ext
    exact generatedPairPhase_one
  map_mul' g h := by
    apply Units.ext
    exact generatedPairPhase_mul g h

end Theta
end SptClassification
