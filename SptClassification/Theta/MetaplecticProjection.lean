module

public import SptClassification.Theta.MetaplecticGeneratedGroup
public import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices

/-!
# Projection of generated metaplectic pairs onto the modular group

The concrete pairs generated by inversion and integral translation cover every
matrix in `SL₂(ℤ)`. This is a statement about the matrix projection, not a
presentation of the pair group or descent of the finite Weil operator. See
[rolenManuscript, lines 339–343].
-/

public section

namespace SptClassification
namespace Theta

/-- The matrix component of a generated pair respects multiplication. -/
noncomputable def generatedPairMatrixHom :
    etaWeilGeneratedSubgroup →* Matrix.SpecialLinearGroup (Fin 2) ℤ where
  toFun g := g.val.matrix
  map_one' := by
    simp only [Subgroup.coe_one, MetaplecticPair.one_eq_identity,
      MetaplecticPair.identity_matrix]
  map_mul' g h := by
    simpa only [Subgroup.coe_mul] using MetaplecticPair.mul_matrix g.val h.val

@[simp] theorem generatedPairMatrixHom_apply (g : etaWeilGeneratedSubgroup) :
    generatedPairMatrixHom g = g.val.matrix := (rfl)

/-- Every determinant-one integral matrix is the matrix component of a
concrete pair built from the standard inversion and translation lifts. -/
theorem generatedPairMatrixHom_surjective :
    Function.Surjective generatedPairMatrixHom := by
  intro A
  have hA : A ∈ Subgroup.closure
      ({ModularGroup.S, ModularGroup.T} :
        Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    simp [SpecialLinearGroup.SL2Z_generators]
  induction hA using Subgroup.closure_induction with
  | one =>
      exact ⟨1, by simp only [generatedPairMatrixHom_apply,
        Subgroup.coe_one, MetaplecticPair.one_eq_identity,
        MetaplecticPair.identity_matrix]⟩
  | mem g hg =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with rfl | rfl
      · refine ⟨⟨EtaWeilStep.inversion.metaplecticPair, ?_⟩, ?_⟩
        apply (mem_etaWeilGeneratedSubgroup_iff _).mpr
        rw [← etaWeilWordMetaplecticPair_singleton]
        exact etaWeilWordMetaplecticPair_mem_generated _
        simp only [generatedPairMatrixHom_apply, EtaWeilStep.metaplecticPair_matrix,
          EtaWeilStep.matrix_inversion]
      · refine ⟨⟨(EtaWeilStep.translation 1).metaplecticPair, ?_⟩, ?_⟩
        apply (mem_etaWeilGeneratedSubgroup_iff _).mpr
        rw [← etaWeilWordMetaplecticPair_singleton]
        exact etaWeilWordMetaplecticPair_mem_generated _
        simp only [generatedPairMatrixHom_apply, EtaWeilStep.metaplecticPair_matrix,
          EtaWeilStep.matrix_translation_one]
  | mul g h _ _ ig ih =>
      rcases ig with ⟨x, rfl⟩
      rcases ih with ⟨y, rfl⟩
      exact ⟨x * y, map_mul generatedPairMatrixHom x y⟩
  | inv g _ ig =>
      rcases ig with ⟨x, rfl⟩
      exact ⟨x⁻¹, map_inv generatedPairMatrixHom x⟩

end Theta
end SptClassification
