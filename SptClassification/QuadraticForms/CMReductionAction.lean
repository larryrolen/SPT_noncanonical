/-!
# The CM generator and the level-six orientation

For a form `[a,b,c]` with CM point `τ`, the generator
`(1 + √D) / 2` is `aτ + (b+1)/2`. Since `6 ∣ a`, its action on the
cyclic subgroup generated by `1/6` has scalar `(b+1)/2` modulo six.
These are calculations in the complex lattice of the given form; reduction
of that lattice and its endomorphism action is a separate geometric step.

The four residue values occur in [rolen2026canonical, Proposition 5.3].
The calculation here takes place before reduction and does not use its
inert-prime hypothesis.
-/

public section

namespace SptClassification

/-- The CM generator with the square-root branch selected by the upper-half-plane point. -/
noncomputable def cmGenerator (D : ℤ) : ℂ :=
  (1 + Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ)) / 2

/-- The chosen branch of the CM generator has positive imaginary part. -/
theorem cmGenerator_im_pos (D : ℤ) [Fact (D < 0)] :
    0 < (cmGenerator D).im := by
  have hD : 0 < -(D : ℝ) := by exact_mod_cast (neg_pos.mpr Fact.out : 0 < -D)
  have hs := Real.sqrt_pos.mpr hD
  simpa [cmGenerator] using (div_pos hs (by norm_num : (0 : ℝ) < 2))

/-- The CM generator cannot be any integer scalar. -/
theorem cmGenerator_ne_intCast (D : ℤ) [Fact (D < 0)] (m : ℤ) :
    cmGenerator D ≠ (m : ℂ) := by
  intro h
  have him := cmGenerator_im_pos D
  rw [h] at him
  simpa using him

/-- Its monic quadratic relation has trace one and norm `(1-D)/4`. -/
theorem cmGenerator_quadratic (D : ℤ) [Fact (D < 0)] (n : ℕ)
    (hn : 4 * (n : ℤ) = 1 - D) :
    cmGenerator D * cmGenerator D - cmGenerator D + (n : ℂ) = 0 := by
  have hnonneg : 0 ≤ -(D : ℝ) := by exact_mod_cast (le_of_lt (neg_pos.mpr Fact.out))
  have hsqrt : (Real.sqrt (-(D : ℝ)) : ℂ) ^ 2 = -(D : ℂ) := by
    exact_mod_cast Real.sq_sqrt hnonneg
  have hsq : (Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ)) ^ 2 = (D : ℂ) := by
    rw [mul_pow, Complex.I_sq, hsqrt]
    ring
  have hnC : (4 : ℂ) * (n : ℂ) = 1 - (D : ℂ) := by exact_mod_cast hn
  unfold cmGenerator
  linear_combination (1 / 4 : ℂ) * hsq + (1 / 4 : ℂ) * hnC

/-- For the manuscript discriminants, the generator has trace one and norm
`(d+1)/4` in its complex quadratic algebra. -/
theorem cmGenerator_quadratic_of_discriminant (d : ℕ)
    [Fact (-(d : ℤ) < 0)] (hmod : d % 24 = 23) :
    cmGenerator (-(d : ℤ)) * cmGenerator (-(d : ℤ)) -
      cmGenerator (-(d : ℤ)) + (((d + 1) / 4 : ℕ) : ℂ) = 0 := by
  apply cmGenerator_quadratic (-(d : ℤ)) ((d + 1) / 4)
  omega

namespace LevelSixForm

/-- The scalar obtained from the middle coefficient of an oriented form.
The numerator is even for the four unit orientations used in the CM products. -/
def cmGeneratorResidue {D : ℤ} {r : ZMod 12} (Q : LevelSixForm D r) : ZMod 6 :=
  (((Q.b + 1) / 2 : ℤ) : ZMod 6)

private theorem middle_coefficient_congruent (b r : ℤ)
    (h : (b : ZMod 12) = (r : ZMod 12)) : 12 ∣ b - r := by
  apply (ZMod.intCast_zmod_eq_zero_iff_dvd (b - r) 12).mp
  simpa only [Int.cast_sub] using (sub_eq_zero.mpr h)

private theorem residue_from_middle_coefficient (b r k : ℤ)
    (h : (b : ZMod 12) = (r : ZMod 12)) (hk : 2 * k = r + 1) :
    (((b + 1) / 2 : ℤ) : ZMod 6) = (k : ZMod 6) := by
  obtain ⟨j, hj⟩ := middle_coefficient_congruent b r h
  have hdiv : 6 ∣ (b + 1) / 2 - k := by
    refine ⟨j, ?_⟩
    omega
  have hz : ((((b + 1) / 2 - k : ℤ) : ZMod 6)) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 6).mpr hdiv
  exact sub_eq_zero.mp (by simpa only [Int.cast_sub] using hz)

private theorem middle_coefficient_odd (b r : ℤ)
    (h : (b : ZMod 12) = (r : ZMod 12)) (hr : r % 2 = 1) :
    b % 2 = 1 := by
  obtain ⟨j, hj⟩ := middle_coefficient_congruent b r h
  omega

/-- The generator scalar depends only on the level-six orientation, so it is
well defined on the `Γ₀(6)` orbit of the form. -/
theorem cmGeneratorResidue_eq_of_same_orientation {D : ℤ} {r : ZMod 12}
    (Q R : LevelSixForm D r) : Q.cmGeneratorResidue = R.cmGeneratorResidue := by
  obtain ⟨j, hj⟩ := middle_coefficient_congruent Q.b R.b
    (Q.b_residue.trans R.b_residue.symm)
  have hdiv : 6 ∣ (Q.b + 1) / 2 - (R.b + 1) / 2 := by
    refine ⟨j, ?_⟩
    omega
  have hz : (((Q.b + 1) / 2 - (R.b + 1) / 2 : ℤ) : ZMod 6) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 6).mpr hdiv
  exact sub_eq_zero.mp (by simpa only [cmGeneratorResidue, Int.cast_sub] using hz)

/-- Every orientation used by the two CM products has an odd middle coefficient. -/
theorem middle_coefficient_odd_of_product_orientation {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (hr : r = 1 ∨ r = 5 ∨ r = 7 ∨ r = 11) :
    Q.b % 2 = 1 := by
  rcases hr with rfl | rfl | rfl | rfl
  · exact middle_coefficient_odd Q.b 1 Q.b_residue (by omega)
  · exact middle_coefficient_odd Q.b 5 Q.b_residue (by omega)
  · exact middle_coefficient_odd Q.b 7 Q.b_residue (by omega)
  · exact middle_coefficient_odd Q.b 11 Q.b_residue (by omega)

/-- In orientation `1`, the generator acts by `1` on the standard six-torsion. -/
theorem cmGeneratorResidue_one {D : ℤ} (Q : LevelSixForm D 1) :
    Q.cmGeneratorResidue = 1 := by
  exact residue_from_middle_coefficient Q.b 1 1 Q.b_residue (by omega)

/-- In orientation `11`, the generator acts by `0` on the standard six-torsion. -/
theorem cmGeneratorResidue_eleven {D : ℤ} (Q : LevelSixForm D 11) :
    Q.cmGeneratorResidue = 0 := by
  calc
    Q.cmGeneratorResidue = (6 : ZMod 6) :=
      residue_from_middle_coefficient Q.b 11 6 Q.b_residue (by omega)
    _ = 0 := by decide

/-- In orientation `5`, the generator acts by `3` on the standard six-torsion. -/
theorem cmGeneratorResidue_five {D : ℤ} (Q : LevelSixForm D 5) :
    Q.cmGeneratorResidue = 3 := by
  exact residue_from_middle_coefficient Q.b 5 3 Q.b_residue (by omega)

/-- In orientation `7`, the generator acts by `4` on the standard six-torsion. -/
theorem cmGeneratorResidue_seven {D : ℤ} (Q : LevelSixForm D 7) :
    Q.cmGeneratorResidue = 4 := by
  exact residue_from_middle_coefficient Q.b 7 4 Q.b_residue (by omega)

/-- The form's CM generator in its complex lattice, with the positive square-root
branch fixed by the upper-half-plane CM point. -/
theorem cmGenerator_eq_a_mul_cmPoint_add {D : ℤ} {r : ZMod 12}
    [Fact (D < 0)] (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1) :
    cmGenerator D =
      (Q.a : ℂ) * Q.cmPoint + (((Q.b + 1) / 2 : ℤ) : ℂ) := by
  have hmiddle : 2 * ((Q.b + 1) / 2) = Q.b + 1 := by omega
  have hmiddleC : (2 : ℂ) * (((Q.b + 1) / 2 : ℤ) : ℂ) = (Q.b : ℂ) + 1 := by
    exact_mod_cast hmiddle
  have hpoint : 2 * (Q.a : ℂ) * Q.cmPoint + (Q.b : ℂ) =
      Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ) := by
    simpa only [cmPoint_eq_toPositiveForm, LevelSixForm.toPositiveForm_toBinaryQuadraticForm]
      using Q.toPositiveForm.twice_a_cmPoint_add_b
  calc
    cmGenerator D =
        (Q.a : ℂ) * Q.cmPoint + (((Q.b + 1) / 2 : ℤ) : ℂ) := by
      unfold cmGenerator
      linear_combination (-1 / 2 : ℂ) * hpoint + (-1 / 2 : ℂ) * hmiddleC

/-- The CM generator also preserves the second period of the form lattice.
Together with `cmGenerator_eq_a_mul_cmPoint_add`, this gives its integral
action on the lattice `ℤ + ℤτ` before passage to level-six torsion. -/
theorem cmGenerator_mul_cmPoint {D : ℤ} {r : ZMod 12}
    [Fact (D < 0)] (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1) :
    cmGenerator D * (Q.cmPoint : ℂ) =
      (((Q.b + 1) / 2 - Q.b : ℤ) : ℂ) * Q.cmPoint - (Q.c : ℂ) := by
  have hroot := Q.evaluateOver_cmPoint
  rw [BinaryQuadraticForm.evaluateOver_one] at hroot
  rw [Q.cmGenerator_eq_a_mul_cmPoint_add hodd]
  push_cast
  linear_combination hroot

/-- Multiplication by the CM generator preserves the period lattice of an
oriented form. The coefficients display the integral matrix of its action in
the basis `1, τ`. -/
theorem cmGenerator_mul_periods {D : ℤ} {r : ZMod 12}
    [Fact (D < 0)] (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1)
    (m n : ℤ) :
    cmGenerator D * ((m : ℂ) + (n : ℂ) * Q.cmPoint) =
      (((((Q.b + 1) / 2) * m - Q.c * n : ℤ) : ℂ)) +
        (((Q.a * m + (((Q.b + 1) / 2) - Q.b) * n : ℤ) : ℂ)) * Q.cmPoint := by
  calc
    cmGenerator D * ((m : ℂ) + (n : ℂ) * Q.cmPoint) =
        (m : ℂ) * cmGenerator D + (n : ℂ) * (cmGenerator D * Q.cmPoint) := by ring
    _ = _ := by
      rw [Q.cmGenerator_mul_cmPoint hodd,
        Q.cmGenerator_eq_a_mul_cmPoint_add hodd]
      push_cast
      ring

/-- The integer period coordinates of multiplication by the CM generator in
the basis `1, τ`. The two columns are the images of `1` and `τ`. -/
def cmGeneratorPeriodCoordinates {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (v : ℤ × ℤ) : ℤ × ℤ :=
  ((((Q.b + 1) / 2) * v.1 - Q.c * v.2),
    Q.a * v.1 + (((Q.b + 1) / 2) - Q.b) * v.2)

/-- Multiplication by the CM generator is additive on period coordinates. -/
theorem cmGeneratorPeriodCoordinates_add {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (v w : ℤ × ℤ) :
    Q.cmGeneratorPeriodCoordinates (v + w) =
      Q.cmGeneratorPeriodCoordinates v + Q.cmGeneratorPeriodCoordinates w := by
  rcases v with ⟨m, n⟩
  rcases w with ⟨s, t⟩
  apply Prod.ext
  · change ((Q.b + 1) / 2) * (m + s) - Q.c * (n + t) =
        (((Q.b + 1) / 2) * m - Q.c * n) +
          (((Q.b + 1) / 2) * s - Q.c * t)
    ring
  · change Q.a * (m + s) + (((Q.b + 1) / 2) - Q.b) * (n + t) =
        (Q.a * m + (((Q.b + 1) / 2) - Q.b) * n) +
          (Q.a * s + (((Q.b + 1) / 2) - Q.b) * t)
    ring

/-- The coordinate action is multiplication by the actual complex CM
generator on the form's period lattice. -/
theorem cmGeneratorPeriodCoordinates_complex {D : ℤ} {r : ZMod 12}
    [Fact (D < 0)] (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1)
    (v : ℤ × ℤ) :
    cmGenerator D * ((v.1 : ℂ) + (v.2 : ℂ) * Q.cmPoint) =
      ((Q.cmGeneratorPeriodCoordinates v).1 : ℂ) +
        ((Q.cmGeneratorPeriodCoordinates v).2 : ℂ) * Q.cmPoint := by
  simpa only [cmGeneratorPeriodCoordinates] using
    Q.cmGenerator_mul_periods hodd v.1 v.2

/-- On the cyclic six-torsion line represented by the first period, the
integer coordinate action reduces to the prescribed orientation scalar. -/
theorem cmGeneratorPeriodCoordinates_first_mod_six {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) :
    (((Q.cmGeneratorPeriodCoordinates (1, 0)).1 : ℤ) : ZMod 6) =
        Q.cmGeneratorResidue ∧
      (((Q.cmGeneratorPeriodCoordinates (1, 0)).2 : ℤ) : ZMod 6) = 0 := by
  constructor
  · simp [cmGeneratorPeriodCoordinates, cmGeneratorResidue]
  · simpa [cmGeneratorPeriodCoordinates] using
      (ZMod.intCast_zmod_eq_zero_iff_dvd Q.a 6).mpr Q.six_dvd_a

/-- On the entire cyclic line generated by the first period, the integral
action reduces modulo six to multiplication by the orientation scalar. -/
theorem cmGeneratorPeriodCoordinates_first_line_mod_six {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (m : ℤ) :
    (((Q.cmGeneratorPeriodCoordinates (m, 0)).1 : ℤ) : ZMod 6) =
        Q.cmGeneratorResidue * (m : ZMod 6) ∧
      (((Q.cmGeneratorPeriodCoordinates (m, 0)).2 : ℤ) : ZMod 6) = 0 := by
  have ha : (Q.a : ZMod 6) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd Q.a 6).mpr Q.six_dvd_a
  constructor
  · simp [cmGeneratorPeriodCoordinates, cmGeneratorResidue]
  · simp [cmGeneratorPeriodCoordinates, ha]

/-- The integral period action reduced on the full six-torsion coordinate
module. Its first coordinate line is the cyclic subgroup selected by the
level-six structure. -/
def cmGeneratorSixTorsionCoordinates {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (v : ZMod 6 × ZMod 6) : ZMod 6 × ZMod 6 :=
  (Q.cmGeneratorResidue * v.1 - (Q.c : ZMod 6) * v.2,
    (Q.a : ZMod 6) * v.1 +
      (Q.cmGeneratorResidue - (Q.b : ZMod 6)) * v.2)

/-- Reduction of the integer matrix agrees with its six-torsion action. -/
theorem cmGeneratorSixTorsionCoordinates_cast {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (v : ℤ × ℤ) :
    Q.cmGeneratorSixTorsionCoordinates ((v.1 : ZMod 6), (v.2 : ZMod 6)) =
      (((Q.cmGeneratorPeriodCoordinates v).1 : ZMod 6),
        ((Q.cmGeneratorPeriodCoordinates v).2 : ZMod 6)) := by
  rcases v with ⟨m, n⟩
  apply Prod.ext <;>
    simp [cmGeneratorSixTorsionCoordinates, cmGeneratorPeriodCoordinates,
      cmGeneratorResidue]

/-- The reduction of the integral CM action is additive on all six-torsion
coordinates, before restricting it to the selected cyclic subgroup. -/
theorem cmGeneratorSixTorsionCoordinates_add {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (v w : ZMod 6 × ZMod 6) :
    Q.cmGeneratorSixTorsionCoordinates (v + w) =
      Q.cmGeneratorSixTorsionCoordinates v + Q.cmGeneratorSixTorsionCoordinates w := by
  rcases v with ⟨m, n⟩
  rcases w with ⟨s, t⟩
  apply Prod.ext
  · change Q.cmGeneratorResidue * (m + s) - (Q.c : ZMod 6) * (n + t) =
        (Q.cmGeneratorResidue * m - (Q.c : ZMod 6) * n) +
          (Q.cmGeneratorResidue * s - (Q.c : ZMod 6) * t)
    ring
  · change (Q.a : ZMod 6) * (m + s) +
        (Q.cmGeneratorResidue - (Q.b : ZMod 6)) * (n + t) =
        ((Q.a : ZMod 6) * m + (Q.cmGeneratorResidue - (Q.b : ZMod 6)) * n) +
          ((Q.a : ZMod 6) * s + (Q.cmGeneratorResidue - (Q.b : ZMod 6)) * t)
    ring

/-- The entire selected cyclic subgroup is stable under the reduced action,
with precisely the scalar determined by the orientation. -/
theorem cmGeneratorSixTorsionCoordinates_first_line {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (m : ZMod 6) :
    Q.cmGeneratorSixTorsionCoordinates (m, 0) =
      (Q.cmGeneratorResidue * m, 0) := by
  have ha : (Q.a : ZMod 6) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd Q.a 6).mpr Q.six_dvd_a
  apply Prod.ext <;> simp [cmGeneratorSixTorsionCoordinates, ha]

/-- An equivariant specialization of the form's six-torsion coordinates
retains the orientation scalar on the selected cyclic subgroup. The map to
the reduced elliptic curve and the specialized CM endomorphism are separate
geometric data; this result uses only their stated equivariance. -/
theorem cmGeneratorSixTorsionCoordinates_specialize {D : ℤ} {r : ZMod 12}
    {G : Type*} [AddCommGroup G] [Module (ZMod 6) G]
    (Q : LevelSixForm D r)
    (specialize : (ZMod 6 × ZMod 6) →ₗ[ZMod 6] G)
    (reducedAction : G → G)
    (hequiv : ∀ v, reducedAction (specialize v) =
      specialize (Q.cmGeneratorSixTorsionCoordinates v))
    (m : ZMod 6) :
    reducedAction (m • specialize (1, 0)) =
      Q.cmGeneratorResidue • (m • specialize (1, 0)) := by
  have hline (a : ZMod 6) : specialize (a, 0) =
      a • specialize (1, 0) := by
    have hpair : a • ((1 : ZMod 6), (0 : ZMod 6)) = (a, 0) := by
      ext <;> simp
    calc
      specialize (a, 0) = specialize (a • ((1 : ZMod 6), (0 : ZMod 6))) := by
        rw [hpair]
      _ = a • specialize (1, 0) := map_smul specialize a _
  calc
    reducedAction (m • specialize (1, 0)) =
        reducedAction (specialize (m, 0)) :=
      congrArg reducedAction (hline m).symm
    _ = specialize (Q.cmGeneratorSixTorsionCoordinates (m, 0)) := hequiv _
    _ = specialize (Q.cmGeneratorResidue * m, 0) := by
      rw [Q.cmGeneratorSixTorsionCoordinates_first_line]
    _ = (Q.cmGeneratorResidue * m) • specialize (1, 0) := hline _
    _ = Q.cmGeneratorResidue • (m • specialize (1, 0)) := mul_smul _ _ _

/-- On a genuinely cyclic subgroup of order six, a scalar restriction of the
specialized endomorphism must be the scalar of the original oriented form.
Faithfulness of the selected generator is the only cancellation used. -/
theorem cmGeneratorResidue_eq_of_specialization {D : ℤ} {r : ZMod 12}
    {G : Type*} [AddCommGroup G] [Module (ZMod 6) G]
    (Q : LevelSixForm D r)
    (specialize : (ZMod 6 × ZMod 6) →ₗ[ZMod 6] G)
    (reducedAction : G → G) (restriction : ZMod 6)
    (hequiv : ∀ v, reducedAction (specialize v) =
      specialize (Q.cmGeneratorSixTorsionCoordinates v))
    (hrestriction : reducedAction (specialize (1, 0)) =
      restriction • specialize (1, 0))
    (hfaithful : Function.Injective
      (fun a : ZMod 6 => a • specialize (1, 0))) :
    restriction = Q.cmGeneratorResidue := by
  apply hfaithful
  have hspecial := Q.cmGeneratorSixTorsionCoordinates_specialize
    specialize reducedAction hequiv (1 : ZMod 6)
  exact hrestriction.symm.trans (by simpa using hspecial)

/-- Injectivity on full six-torsion makes the selected first coordinate line
faithful. This is the cancellation supplied by prime-to-characteristic torsion
specialization. -/
theorem firstLine_injective_of_injective_specialization {G : Type*}
    [AddCommGroup G] [Module (ZMod 6) G]
    (specialize : (ZMod 6 × ZMod 6) →ₗ[ZMod 6] G)
    (hinjective : Function.Injective specialize) :
    Function.Injective (fun a : ZMod 6 => a • specialize (1, 0)) := by
  intro a b hab
  have hvec : a • ((1 : ZMod 6), (0 : ZMod 6)) =
      b • ((1 : ZMod 6), (0 : ZMod 6)) := by
    apply hinjective
    simpa only [map_smul] using hab
  have hfirst := congrArg Prod.fst hvec
  simpa using hfirst

/-- Injectivity of specialization on full six-torsion supplies the needed
faithfulness of the selected cyclic subgroup. This is the form used when
prime-to-characteristic torsion specialization has been constructed. -/
theorem cmGeneratorResidue_eq_of_injective_specialization
    {D : ℤ} {r : ZMod 12} {G : Type*}
    [AddCommGroup G] [Module (ZMod 6) G]
    (Q : LevelSixForm D r)
    (specialize : (ZMod 6 × ZMod 6) →ₗ[ZMod 6] G)
    (hinjective : Function.Injective specialize)
    (reducedAction : G → G) (restriction : ZMod 6)
    (hequiv : ∀ v, reducedAction (specialize v) =
      specialize (Q.cmGeneratorSixTorsionCoordinates v))
    (hrestriction : reducedAction (specialize (1, 0)) =
      restriction • specialize (1, 0)) :
    restriction = Q.cmGeneratorResidue := by
  apply Q.cmGeneratorResidue_eq_of_specialization specialize reducedAction
    restriction hequiv hrestriction
  exact firstLine_injective_of_injective_specialization specialize hinjective

/-- The integral period-lattice action has trace one. -/
theorem cmGenerator_action_trace {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1) :
    2 * ((Q.b + 1) / 2) - Q.b = 1 := by
  omega

/-- The determinant of the integral period-lattice action, with the factor
four retained to match the manuscript's norm normalization. -/
theorem cmGenerator_action_det {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1) :
    4 * (((Q.b + 1) / 2) * (((Q.b + 1) / 2) - Q.b) + Q.a * Q.c) = 1 - D := by
  let k : ℤ := (Q.b + 1) / 2
  have hb : Q.b = 2 * k - 1 := by
    dsimp [k]
    omega
  have hdisc : Q.b ^ 2 - 4 * Q.a * Q.c = D := by
    simpa only [BinaryQuadraticForm.discriminant] using Q.discriminant_eq
  change 4 * (k * (k - Q.b) + Q.a * Q.c) = 1 - D
  calc
    4 * (k * (k - Q.b) + Q.a * Q.c) =
        1 - (Q.b ^ 2 - 4 * Q.a * Q.c) := by rw [hb]; ring
    _ = 1 - D := by rw [hdisc]

/-- For a manuscript discriminant, the determinant of the integral period
action is exactly the CM norm `(d+1)/4`. -/
theorem cmGenerator_action_det_of_discriminant (d : ℕ) {r : ZMod 12}
    (Q : LevelSixForm (-(d : ℤ)) r) (hodd : Q.b % 2 = 1)
    (hmod : d % 24 = 23) :
    ((Q.b + 1) / 2) * (((Q.b + 1) / 2) - Q.b) + Q.a * Q.c =
      (((d + 1) / 4 : ℕ) : ℤ) := by
  have hdet := Q.cmGenerator_action_det hodd
  omega

/-- On the integer period lattice, the actual CM generator satisfies its
monic quadratic equation with trace one and norm `(d+1)/4`. The same equation
can therefore be reduced modulo any prime without changing its coefficients. -/
theorem cmGeneratorPeriodCoordinates_quadratic (d : ℕ) {r : ZMod 12}
    (Q : LevelSixForm (-(d : ℤ)) r) (hodd : Q.b % 2 = 1)
    (hmod : d % 24 = 23) (v : ℤ × ℤ) :
    Q.cmGeneratorPeriodCoordinates (Q.cmGeneratorPeriodCoordinates v) =
      ((Q.cmGeneratorPeriodCoordinates v).1 - (((d + 1) / 4 : ℕ) : ℤ) * v.1,
       (Q.cmGeneratorPeriodCoordinates v).2 - (((d + 1) / 4 : ℕ) : ℤ) * v.2) := by
  rcases v with ⟨m, n⟩
  let k : ℤ := (Q.b + 1) / 2
  let l : ℤ := k - Q.b
  have htrace : k + l = 1 := by
    dsimp [k, l]
    omega
  have hnorm : k * l + Q.a * Q.c = (((d + 1) / 4 : ℕ) : ℤ) := by
    simpa only [k, l] using Q.cmGenerator_action_det_of_discriminant d hodd hmod
  apply Prod.ext
  · change k * (k * m - Q.c * n) - Q.c * (Q.a * m + l * n) =
        (k * m - Q.c * n) - (((d + 1) / 4 : ℕ) : ℤ) * m
    linear_combination (k * m - Q.c * n) * htrace - m * hnorm
  · change Q.a * (k * m - Q.c * n) + l * (Q.a * m + l * n) =
        (Q.a * m + l * n) - (((d + 1) / 4 : ℕ) : ℤ) * n
    linear_combination (Q.a * m + l * n) * htrace - n * hnorm

/-- The full six-torsion coordinate action retains the CM generator's
quadratic relation. This uses the actual integral period action, so its trace
and norm survive reduction modulo six with the manuscript normalization. -/
theorem cmGeneratorSixTorsionCoordinates_quadratic (d : ℕ) {r : ZMod 12}
    (Q : LevelSixForm (-(d : ℤ)) r) (hodd : Q.b % 2 = 1)
    (hmod : d % 24 = 23) (v : ZMod 6 × ZMod 6) :
    Q.cmGeneratorSixTorsionCoordinates (Q.cmGeneratorSixTorsionCoordinates v) =
      ((Q.cmGeneratorSixTorsionCoordinates v).1 - (((d + 1) / 4 : ℕ) : ZMod 6) * v.1,
        (Q.cmGeneratorSixTorsionCoordinates v).2 -
          (((d + 1) / 4 : ℕ) : ZMod 6) * v.2) := by
  let k : ZMod 6 := Q.cmGeneratorResidue
  let l : ZMod 6 := k - (Q.b : ZMod 6)
  have htraceZ := Q.cmGenerator_action_trace hodd
  have htraceCast : 2 * k - (Q.b : ZMod 6) = 1 := by
    dsimp [k, cmGeneratorResidue]
    simpa only [Int.cast_sub, Int.cast_mul, Int.cast_ofNat, Int.cast_one] using
      congrArg (fun z : ℤ => (z : ZMod 6)) htraceZ
  have htrace : k + l = 1 := by
    dsimp [l]
    linear_combination htraceCast
  have hnormZ := Q.cmGenerator_action_det_of_discriminant d hodd hmod
  have hnorm : k * l + (Q.a : ZMod 6) * (Q.c : ZMod 6) =
      (((d + 1) / 4 : ℕ) : ZMod 6) := by
    dsimp [k, l, cmGeneratorResidue]
    simpa only [Int.cast_add, Int.cast_sub, Int.cast_mul, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ZMod 6)) hnormZ
  rcases v with ⟨m, n⟩
  apply Prod.ext
  · change k * (k * m - (Q.c : ZMod 6) * n) -
        (Q.c : ZMod 6) * ((Q.a : ZMod 6) * m + l * n) =
        (k * m - (Q.c : ZMod 6) * n) - (((d + 1) / 4 : ℕ) : ZMod 6) * m
    linear_combination (k * m - (Q.c : ZMod 6) * n) * htrace - m * hnorm
  · change (Q.a : ZMod 6) * (k * m - (Q.c : ZMod 6) * n) +
        l * ((Q.a : ZMod 6) * m + l * n) =
        ((Q.a : ZMod 6) * m + l * n) - (((d + 1) / 4 : ℕ) : ZMod 6) * n
    linear_combination ((Q.a : ZMod 6) * m + l * n) * htrace - n * hnorm

/-- For the manuscript discriminants, the CM generator's norm is divisible
by six. The quotient is taken in the natural numbers before reduction. -/
theorem cmGenerator_norm_mod_six (d : ℕ) (hmod : d % 24 = 23) :
    ((((d + 1) / 4 : ℕ) : ZMod 6)) = 0 := by
  have hdiv : 6 ∣ (d + 1) / 4 := by omega
  exact (ZMod.natCast_eq_zero_iff ((d + 1) / 4) 6).mpr hdiv

/-- The actual integral CM action becomes an idempotent on the full
six-torsion coordinate module for discriminants congruent to `23` mod `24`. -/
theorem cmGeneratorSixTorsionCoordinates_idempotent (d : ℕ) {r : ZMod 12}
    (Q : LevelSixForm (-(d : ℤ)) r) (hodd : Q.b % 2 = 1)
    (hmod : d % 24 = 23) (v : ZMod 6 × ZMod 6) :
    Q.cmGeneratorSixTorsionCoordinates (Q.cmGeneratorSixTorsionCoordinates v) =
      Q.cmGeneratorSixTorsionCoordinates v := by
  simpa only [cmGenerator_norm_mod_six d hmod, zero_mul, sub_zero] using
    Q.cmGeneratorSixTorsionCoordinates_quadratic d hodd hmod v

/-- The form generator sends `1/6` to the prescribed scalar multiple of `1/6`
modulo the period lattice `ℤ + ℤτ`. The displayed equality provides the
integer lattice coefficient explicitly. -/
theorem cmGenerator_on_six_torsion {D : ℤ} {r : ZMod 12}
    [Fact (D < 0)] (Q : LevelSixForm D r) (hodd : Q.b % 2 = 1) :
    ∃ k : ℤ,
      cmGenerator D / 6 =
        (k : ℂ) * Q.cmPoint + ((((Q.b + 1) / 2 : ℤ) : ℂ) / 6) := by
  obtain ⟨k, hk⟩ := Q.six_dvd_a
  refine ⟨k, ?_⟩
  have hkC : (Q.a : ℂ) = 6 * (k : ℂ) := by exact_mod_cast hk
  calc
    cmGenerator D / 6 =
        ((Q.a : ℂ) * Q.cmPoint + (((Q.b + 1) / 2 : ℤ) : ℂ)) / 6 := by
      rw [Q.cmGenerator_eq_a_mul_cmPoint_add hodd]
    _ = (k : ℂ) * Q.cmPoint + ((((Q.b + 1) / 2 : ℤ) : ℂ) / 6) := by
      rw [hkC]
      ring

/-- The first pair of product orientations gives the eigenvalues `0` and `1`. -/
theorem cmGeneratorResidue_first_pair {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (hr : r = 1 ∨ r = 11) :
    Q.cmGeneratorResidue = 0 ∨ Q.cmGeneratorResidue = 1 := by
  rcases hr with rfl | rfl
  · exact Or.inr Q.cmGeneratorResidue_one
  · exact Or.inl Q.cmGeneratorResidue_eleven

/-- The second pair of product orientations gives the eigenvalues `3` and `4`. -/
theorem cmGeneratorResidue_second_pair {D : ℤ} {r : ZMod 12}
    (Q : LevelSixForm D r) (hr : r = 5 ∨ r = 7) :
    Q.cmGeneratorResidue = 3 ∨ Q.cmGeneratorResidue = 4 := by
  rcases hr with rfl | rfl
  · exact Or.inl Q.cmGeneratorResidue_five
  · exact Or.inr Q.cmGeneratorResidue_seven

end LevelSixForm

namespace CMClass

/-- The action of the CM generator on the standard cyclic six-torsion class,
independent of the representative of an oriented CM orbit. -/
def cmGeneratorResidue {D : ℤ} {r : ZMod 12} [Fact (D < 0)] :
    CMClass D r → ZMod 6 :=
  Quotient.lift (fun Q : LevelSixForm D r => Q.cmGeneratorResidue) (by
    intro Q R _
    exact Q.cmGeneratorResidue_eq_of_same_orientation R)

/-- The first pair of CM products has generator scalar in `{0,1}`. -/
theorem cmGeneratorResidue_first_pair {D : ℤ} {r : ZMod 12} [Fact (D < 0)]
    (C : CMClass D r) (hr : r = 1 ∨ r = 11) :
    C.cmGeneratorResidue = 0 ∨ C.cmGeneratorResidue = 1 := by
  induction C using Quotient.inductionOn with
  | h Q => exact Q.cmGeneratorResidue_first_pair hr

/-- The second pair of CM products has generator scalar in `{3,4}`. -/
theorem cmGeneratorResidue_second_pair {D : ℤ} {r : ZMod 12} [Fact (D < 0)]
    (C : CMClass D r) (hr : r = 5 ∨ r = 7) :
    C.cmGeneratorResidue = 3 ∨ C.cmGeneratorResidue = 4 := by
  induction C using Quotient.inductionOn with
  | h Q => exact Q.cmGeneratorResidue_second_pair hr

/-- The generator scalars of the two product orientations can be neither
equal nor complementary on the standard cyclic subgroup of order six. -/
theorem cmGeneratorResidue_disjoint {D : ℤ} {r s : ZMod 12} [Fact (D < 0)]
    (C : CMClass D r) (E : CMClass D s)
    (hr : r = 1 ∨ r = 11) (hs : s = 5 ∨ s = 7) :
    E.cmGeneratorResidue ≠ C.cmGeneratorResidue ∧
      E.cmGeneratorResidue ≠ 1 - C.cmGeneratorResidue := by
  rcases C.cmGeneratorResidue_first_pair hr with hC | hC <;>
    rcases E.cmGeneratorResidue_second_pair hs with hE | hE <;>
    simp [hC, hE] <;> decide

end CMClass

namespace PrimitiveCMClass

/-- The generator scalar for a factor of the first actual CM product is
zero or one on the standard cyclic subgroup. -/
theorem cmGeneratorResidue_first_pair {D : ℤ} {r : ZMod 12} [Fact (D < 0)]
    (C : PrimitiveCMClass D r) (hr : r = 1 ∨ r = 11) :
    C.val.cmGeneratorResidue = 0 ∨ C.val.cmGeneratorResidue = 1 :=
  C.val.cmGeneratorResidue_first_pair hr

/-- The generator scalar for a factor of the second actual CM product is
three or four on the standard cyclic subgroup. -/
theorem cmGeneratorResidue_second_pair {D : ℤ} {r : ZMod 12} [Fact (D < 0)]
    (C : PrimitiveCMClass D r) (hr : r = 5 ∨ r = 7) :
    C.val.cmGeneratorResidue = 3 ∨ C.val.cmGeneratorResidue = 4 :=
  C.val.cmGeneratorResidue_second_pair hr

/-- Factors from the two actual products have incompatible generator actions.
The comparison is in the cyclic subgroup before reduction. -/
theorem cmGeneratorResidue_disjoint {D : ℤ} {r s : ZMod 12} [Fact (D < 0)]
    (C : PrimitiveCMClass D r) (E : PrimitiveCMClass D s)
    (hr : r = 1 ∨ r = 11) (hs : s = 5 ∨ s = 7) :
    E.val.cmGeneratorResidue ≠ C.val.cmGeneratorResidue ∧
      E.val.cmGeneratorResidue ≠ 1 - C.val.cmGeneratorResidue :=
  C.val.cmGeneratorResidue_disjoint E.val hr hs

end PrimitiveCMClass

end SptClassification
