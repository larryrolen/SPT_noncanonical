/-!
# Descent of the underlying CM curve from its j-invariant

The model is mathlib's `WeierstrassCurve.ofJ`, whose coefficients use only the
prescribed invariant [silverman2009, Chapter III, Proposition 1.4(c)]. Equal
j-invariants over a separably closed field give an actual admissible change of
variables. This descends the unmarked curve; transporting the CM endomorphism
and the cyclic-six subgroup to a good-reduction model remains separate.
-/

public section

namespace SptClassification

namespace WeierstrassDescent

/-- A j-value in the smaller field supplies a model geometrically isomorphic
to the given curve, without asserting that its original coefficients descend. -/
theorem exists_variableChange_of_j_preimage
    {K F : Type*} [Field K] [DecidableEq K] [Field F] [IsSepClosed F]
    (ι : K →+* F) (E : WeierstrassCurve F) [E.IsElliptic]
    (j : K) (hj : ι j = E.j) :
    ∃ C : WeierstrassCurve.VariableChange F,
      C • ((WeierstrassCurve.ofJ j).map ι) = E := by
  apply WeierstrassCurve.exists_variableChange_of_j_eq
  rw [WeierstrassCurve.map_j, WeierstrassCurve.ofJ_j]
  exact hj

/-- The actual subfield of `ℂ` generated by the invariant. Its finiteness is
proved separately from algebraicity of that invariant. -/
noncomputable def invariantField (E : WeierstrassCurve ℂ) [E.IsElliptic] :
    IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {E.j}

/-- A concrete model over `ℚ(j(E))`, including the exceptional invariants
zero and 1728 through mathlib's prescribed-invariant construction. -/
noncomputable def model (E : WeierstrassCurve ℂ) [E.IsElliptic] :
    WeierstrassCurve (invariantField E) :=
  WeierstrassCurve.ofJ ⟨E.j, IntermediateField.mem_adjoin_simple_self ℚ E.j⟩

instance model_isElliptic (E : WeierstrassCurve ℂ) [E.IsElliptic] :
    (model E).IsElliptic := by
  unfold model
  infer_instance

/-- Algebraicity of j makes this particular coefficient field finite over ℚ. -/
theorem invariantField_finiteDimensional (E : WeierstrassCurve ℂ) [E.IsElliptic]
    (hj : IsAlgebraic ℚ E.j) : FiniteDimensional ℚ (invariantField E) :=
  IntermediateField.adjoin.finiteDimensional hj.isIntegral

/-- After the specified inclusion into ℂ, the model is related to the original
curve by an admissible change of variables. No equality of the coefficients
of the original lattice equation with algebraic numbers is required. -/
theorem model_variableChange (E : WeierstrassCurve ℂ) [E.IsElliptic] :
    ∃ C : WeierstrassCurve.VariableChange ℂ,
      C • ((model E).map (invariantField E).subtype) = E := by
  unfold model
  exact exists_variableChange_of_j_preimage (invariantField E).subtype E
    (⟨E.j, IntermediateField.mem_adjoin_simple_self ℚ E.j⟩ : invariantField E) rfl

end WeierstrassDescent

namespace LevelSixForm

/-- The actual lattice cubic has a model over any field containing its
j-invariant. The change of variables is over `ℂ`, not necessarily over that
smaller field. No assertion about the marked subgroup is hidden here. -/
theorem complexCurve_model_of_j_preimage
    {D : ℤ} {r : ZMod 12} [Fact (D < 0)] (Q : LevelSixForm D r)
    {K : Type*} [Field K] [DecidableEq K] (ι : K →+* ℂ) (j : K)
    (hj : letI := Q.complexCurve_isElliptic; ι j = Q.complexCurve.j) :
    ∃ C : WeierstrassCurve.VariableChange ℂ,
      C • ((WeierstrassCurve.ofJ j).map ι) = Q.complexCurve := by
  letI := Q.complexCurve_isElliptic
  exact WeierstrassDescent.exists_variableChange_of_j_preimage ι Q.complexCurve j hj

/-- Algebraicity of the CM j-invariant supplies a finite coefficient field
and an actual complex change of variables to the original lattice cubic.
The algebraicity hypothesis remains explicit pending its CM source interface. -/
theorem complexCurve_finite_model_of_algebraic_j
    {D : ℤ} {r : ZMod 12} [Fact (D < 0)] (Q : LevelSixForm D r)
    (hj : letI := Q.complexCurve_isElliptic; IsAlgebraic ℚ Q.complexCurve.j) :
    letI := Q.complexCurve_isElliptic
    FiniteDimensional ℚ (WeierstrassDescent.invariantField Q.complexCurve) ∧
      ∃ C : WeierstrassCurve.VariableChange ℂ,
        C • ((WeierstrassDescent.model Q.complexCurve).map
          (WeierstrassDescent.invariantField Q.complexCurve).subtype) = Q.complexCurve := by
  letI := Q.complexCurve_isElliptic
  exact ⟨WeierstrassDescent.invariantField_finiteDimensional Q.complexCurve hj,
    WeierstrassDescent.model_variableChange Q.complexCurve⟩

end LevelSixForm

end SptClassification
