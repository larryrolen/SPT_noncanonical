module

public import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# A field of definition for an affine elliptic point

Adjoin the actual coordinates to the coefficient field. The resulting point
maps back to the original one; the extension is finite when its two generators
are algebraic. This construction does not change the elliptic equation.
-/

public section

namespace SptClassification.PointDescent

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- The subfield generated by the two coordinates, inside the given extension. -/
noncomputable def coordinateField (x y : F) : IntermediateField K F :=
  IntermediateField.adjoin K {x, y}

theorem coordinateField_finiteDimensional {x y : F}
    (hx : IsAlgebraic K x) (hy : IsAlgebraic K y) :
    FiniteDimensional K (coordinateField (K := K) x y) :=
  IntermediateField.finiteDimensional_adjoin_pair hx.isIntegral hy.isIntegral

/-- The first actual coordinate as an element of the field it generates. -/
noncomputable def xCoordinate (x y : F) : coordinateField (K := K) x y :=
  ⟨x, IntermediateField.subset_adjoin K _ (by simp)⟩

/-- The second actual coordinate as an element of the field it generates. -/
noncomputable def yCoordinate (x y : F) : coordinateField (K := K) x y :=
  ⟨y, IntermediateField.subset_adjoin K _ (by simp)⟩

variable [DecidableEq F]

/-- Coordinates of an affine nonsingular point, with its equality to the
specified point. The coordinates are data, not merely an existence assertion. -/
structure Coordinates (W : WeierstrassCurve K) (P : (W.toAffine.baseChange F).Point) where
  x : F
  y : F
  nonsingular : (W.toAffine.baseChange F).Nonsingular x y
  point_eq : WeierstrassCurve.Affine.Point.some x y nonsingular = P

/-- Every nonzero point is represented by affine coordinates. -/
theorem coordinates_nonempty (W : WeierstrassCurve K)
    (P : (W.toAffine.baseChange F).Point) (hP : P ≠ 0) :
    Nonempty (Coordinates W P) := by
  cases P with
  | zero => exact (hP rfl).elim
  | some x y h => exact ⟨⟨x, y, h, rfl⟩⟩

/-- A fixed affine representation of the specified nonzero point. -/
noncomputable def coordinates (W : WeierstrassCurve K)
    (P : (W.toAffine.baseChange F).Point) (hP : P ≠ 0) : Coordinates W P :=
  Classical.choice (coordinates_nonempty W P hP)

/-- Prime-to-characteristic torsion has algebraic affine coordinates.

Literature input: [silverman2009, Chapter III §6, Corollary 6.4] gives
`deg [n] = n²`; for `n` nonzero in the field the zero fiber of this finite
morphism is finite over the coefficient field. Its coordinate residue fields
are algebraic. This is the finite-fiber corollary, not a claim that the source
states this exact coordinate interface. The section/theorem locator has not
been independently checked against a primary copy in this formalization. -/
theorem torsion_coordinates_isAlgebraic (W : WeierstrassCurve K) [W.IsElliptic]
    {x y : F} (h : (W.toAffine.baseChange F).Nonsingular x y)
    (n : ℕ) (hn : (n : K) ≠ 0)
    (hP : n • (WeierstrassCurve.Affine.Point.some x y h) = 0) :
    IsAlgebraic K x ∧ IsAlgebraic K y := by
  sorry

/-- The actual coordinate field of a torsion point is finite. -/
theorem coordinateField_finiteDimensional_of_torsion
    (W : WeierstrassCurve K) [W.IsElliptic]
    {x y : F} (h : (W.toAffine.baseChange F).Nonsingular x y)
    (n : ℕ) (hn : (n : K) ≠ 0)
    (hP : n • (WeierstrassCurve.Affine.Point.some x y h) = 0) :
    FiniteDimensional K (coordinateField (K := K) x y) := by
  obtain ⟨hx, hy⟩ := torsion_coordinates_isAlgebraic W h n hn hP
  exact coordinateField_finiteDimensional hx hy

/-- Nonsingularity descends because the field inclusion is injective. -/
theorem coordinates_nonsingular (W : WeierstrassCurve K) {x y : F}
    (h : (W.toAffine.baseChange F).Nonsingular x y) :
    (W.toAffine.baseChange (coordinateField (K := K) x y)).Nonsingular
      (xCoordinate (K := K) x y) (yCoordinate (K := K) x y) := by
  apply (WeierstrassCurve.Affine.map_nonsingular _
    (coordinateField (K := K) x y).subtype.injective _ _).mp
  have hc : (coordinateField (K := K) x y).subtype.comp
      (algebraMap K (coordinateField (K := K) x y)) = algebraMap K F := by
    ext a
    rfl
  have hx : (coordinateField (K := K) x y).subtype
      (xCoordinate (K := K) x y) = x := rfl
  have hy : (coordinateField (K := K) x y).subtype
      (yCoordinate (K := K) x y) = y := rfl
  simpa only [WeierstrassCurve.baseChange, WeierstrassCurve.map_map, hc, hx, hy] using h

/-- The affine point over its actual coordinate field. -/
noncomputable def point (W : WeierstrassCurve K) {x y : F}
    (h : (W.toAffine.baseChange F).Nonsingular x y) :
    (W.toAffine.baseChange (coordinateField (K := K) x y)).Point := by
  classical
  exact .some (xCoordinate (K := K) x y) (yCoordinate (K := K) x y)
    (coordinates_nonsingular W h)

/-- Base change recovers the selected point, including its marking. -/
theorem map_point (W : WeierstrassCurve K) {x y : F}
    (h : (W.toAffine.baseChange F).Nonsingular x y) :
    letI := Classical.decEq (coordinateField (K := K) x y)
    WeierstrassCurve.Affine.Point.map (W' := W.toAffine)
      (coordinateField (K := K) x y).val (point W h) = .some x y h := by
  classical
  rfl

/-- The base-change map is injective, so it preserves the exact point order. -/
theorem point_order (W : WeierstrassCurve K) {x y : F}
    (h : (W.toAffine.baseChange F).Nonsingular x y) :
    letI := Classical.decEq (coordinateField (K := K) x y)
    addOrderOf (point W h) = addOrderOf (.some x y h : (W.toAffine.baseChange F).Point) := by
  letI := Classical.decEq (coordinateField (K := K) x y)
  apply Nat.dvd_antisymm
  · apply addOrderOf_dvd_of_nsmul_eq_zero
    apply WeierstrassCurve.Affine.Point.map_injective
      (W' := W.toAffine) (coordinateField (K := K) x y).val
    rw [map_nsmul, map_zero, map_point, addOrderOf_nsmul_eq_zero]
  · apply addOrderOf_dvd_of_nsmul_eq_zero
    rw [← map_point W h, ← map_nsmul, addOrderOf_nsmul_eq_zero, map_zero]

end SptClassification.PointDescent
