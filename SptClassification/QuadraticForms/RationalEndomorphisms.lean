/-!
# The ring generated by rational elliptic point maps

This is a subring of the endomorphisms of the actual geometric point group.
Its action is the inclusion, so coordinate maps and point actions cannot be
chosen independently. The classical closure and surjectivity statements are
explicit literature inputs; no CM specialization is asserted here.
-/

public section

namespace SptClassification.RationalPointMap

variable {F : Type*} [Field F] [DecidableEq F]

/-- The subring generated by point maps with compatible rational coordinates.
Over an algebraically closed field on a smooth cubic, the classical closure
lemma below says every member still has rational coordinates. -/
def endomorphismRing (W : WeierstrassCurve F) :
    Subring (AddMonoid.End W.toAffine.Point) :=
  Subring.closure {f | IsRational f}

/-- The faithful action on the actual elliptic point group. -/
def pointAction (W : WeierstrassCurve F) :
    endomorphismRing W →+* AddMonoid.End W.toAffine.Point :=
  (endomorphismRing W).subtype

/-- A supplied rational map defines an element of the actual endomorphism ring. -/
def ofRational {W : WeierstrassCurve F}
    (f : AddMonoid.End W.toAffine.Point) (hf : IsRational f) : endomorphismRing W :=
  ⟨f, Subring.subset_closure hf⟩

theorem pointAction_ofRational {W : WeierstrassCurve F}
    (f : AddMonoid.End W.toAffine.Point) (hf : IsRational f) :
    pointAction W (ofRational f hf) = f := (rfl)

theorem pointAction_injective (W : WeierstrassCurve F) :
    Function.Injective (pointAction W) :=
  Subtype.val_injective

/-- Closure of algebraic elliptic endomorphisms under the group law and
composition [silverman2009, Chapter III, §§2,4]. Rational maps from a smooth
projective curve extend across the exceptional points [Chapter II, §2];
the additive point-map uniqueness lemma identifies the extension everywhere.
This named literature interface uses section locators; no primary theorem
number has been independently verified. -/
theorem endomorphismRing_isRational [IsAlgClosed F]
    (W : WeierstrassCurve F) (hW : W.IsElliptic) (f : endomorphismRing W) :
    IsRational (pointAction W f) := by
  sorry

/-- A nonzero algebraic elliptic endomorphism is surjective on geometric
points [silverman2009, Chapter II, §2, nonconstant maps of projective curves;
Chapter III, §4, isogenies]. The rational description is compatible with the
specified additive point map, including the exceptional points by uniqueness.
This is a named literature admission with section-level source locators. -/
theorem surjective_of_isRational [IsAlgClosed F]
    (W : WeierstrassCurve F) (hW : W.IsElliptic)
    (f : AddMonoid.End W.toAffine.Point) (hf : IsRational f) (hne : f ≠ 0) :
    Function.Surjective f := by
  sorry

/-- Cancellation under composition follows from surjectivity of every nonzero
rational endomorphism. This proof uses the actual point action. -/
theorem endomorphismRing_noZeroDivisors [IsAlgClosed F]
    (W : WeierstrassCurve F) (hW : W.IsElliptic) :
    NoZeroDivisors (endomorphismRing W) := by
  refine ⟨?_⟩
  intro f g hfg
  by_cases hg : g = 0
  · exact Or.inr hg
  left
  have hgne : pointAction W g ≠ 0 := by
    intro h
    apply hg
    exact Subtype.ext h
  have hsurj := surjective_of_isRational W hW (pointAction W g)
    (endomorphismRing_isRational W hW g) hgne
  apply Subtype.ext
  apply AddMonoidHom.ext
  intro x
  obtain ⟨y, rfl⟩ := hsurj x
  have heq := congrArg (fun k : endomorphismRing W => pointAction W k y) hfg
  exact heq

end SptClassification.RationalPointMap
