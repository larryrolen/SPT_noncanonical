/-! # The all-prime bound for two oriented actions on a six-torsion point -/

public section

namespace SptClassification.RationalPointMap

/-- Opposite orientation scalars on one actual point of order six force the
manuscript kernel bound. Noncommutation first excludes ordinary reduction;
the supersingular estimate then applies to the subgroup generated by `P`. -/
theorem kernel_bound_of_oriented_point_actions
    {F : Type*} [Field F] [DecidableEq F] [IsAlgClosed F]
    (p : ℕ) [Fact p.Prime] [CharP F p] (hp : 3 < p)
    (W : WeierstrassCurve F) (hW : W.IsElliptic)
    (P : W.toAffine.Point) (hP : addOrderOf P = 6)
    (n : ℕ) (hn : 0 < n) (hpn : ¬p ∣ n)
    (a b : endomorphismRing W)
    (ha : a * a - a + (n : endomorphismRing W) = 0)
    (hb : b * b - b + (n : endomorphismRing W) = 0)
    (m k : ℤ) (ham : pointAction W a P = m • P)
    (hbk : pointAction W b P = k • P)
    (hm : m % 6 = 0 ∨ m % 6 = 1) (hk : k % 6 = 3 ∨ k % 6 = 4) :
    6 * p ≤ 4 * n * n := by
  let := endomorphismRing_noZeroDivisors W hW
  have hne := oriented_point_actions_not_commute (pointAction W)
    a b (n : endomorphismRing W) P hP ha hb m k ham hbk hm hk
  have hss := prime_torsion_eq_zero_of_not_commute p W hW a b hne
  have hpres {f : endomorphismRing W} {j : ℤ}
      (hf : pointAction W f P = j • P) :
      ∀ y ∈ AddSubgroup.zmultiples P,
        pointAction W f y ∈ AddSubgroup.zmultiples P := by
    rintro y ⟨i, rfl⟩
    rw [map_zsmul, hf]
    exact ⟨i * j, mul_zsmul _ _ _⟩
  have hbound := supersingular_kernel_bound p hp W hW hss P hP a b
    (hasPrimeToCharFactor_of_quadratic p W a n hn hpn ha)
    (hasPrimeToCharFactor_of_quadratic p W b n hn hpn hb)
    (hpres ham) (hpres hbk) hne
  rw [kernelCard_eq_of_quadratic p W hW a n hn hpn ha,
    kernelCard_eq_of_quadratic p W hW b n hn hpn hb] at hbound
  exact hbound

end SptClassification.RationalPointMap
