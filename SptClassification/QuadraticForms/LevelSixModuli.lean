module

public import SptClassification.QuadraticForms.RationalCurveIsomorphism
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Geometric classes of cyclic level-six pairs

A representative is an actual elliptic cubic with a point of exact order six.
The equivalence relation remembers only the subgroup generated by the point.
Consequently changing its generator does not change the class. This defines
the geometric marked-pair classes; identification with the integral modular
curve and its eta coordinate is a separate literature correspondence.
-/

public section

namespace SptClassification

variable {F : Type*} [Field F] [DecidableEq F] [IsAlgClosed F]

namespace RationalPointMap.CurveEquiv

/-- Identity rational isomorphism on a geometric elliptic curve. -/
noncomputable def refl (W : WeierstrassCurve F) (hW : W.IsElliptic) :
    CurveEquiv W W where
  toAddEquiv := AddEquiv.refl _
  rational := by
    have h : (AddEquiv.refl W.toAffine.Point).toAddMonoidHom =
        (1 : AddMonoid.End W.toAffine.Point) := by ext x; rfl
    rw [h, ← map_one (pointAction W)]
    exact endomorphismRing_isRational W hW 1
  inverse_rational := by
    have h : (AddEquiv.refl W.toAffine.Point).symm.toAddMonoidHom =
        (1 : AddMonoid.End W.toAffine.Point) := by ext x; rfl
    rw [h, ← map_one (pointAction W)]
    exact endomorphismRing_isRational W hW 1

/-- Composition of rational isomorphisms of geometric elliptic curves. -/
noncomputable def trans {W₁ W₂ W₃ : WeierstrassCurve F}
    (e : CurveEquiv W₁ W₂) (f : CurveEquiv W₂ W₃)
    (hW₁ : W₁.IsElliptic) (hW₂ : W₂.IsElliptic) (hW₃ : W₃.IsElliptic) :
    CurveEquiv W₁ W₃ where
  toAddEquiv := e.toAddEquiv.trans f.toAddEquiv
  rational := isRational_comp hW₁ hW₂ hW₃ _ _ f.rational e.rational
  inverse_rational :=
    isRational_comp hW₃ hW₂ hW₁ _ _ e.inverse_rational f.inverse_rational

theorem trans_apply {W₁ W₂ W₃ : WeierstrassCurve F}
    (e : CurveEquiv W₁ W₂) (f : CurveEquiv W₂ W₃)
    (hW₁ : W₁.IsElliptic) (hW₂ : W₂.IsElliptic) (hW₃ : W₃.IsElliptic)
    (x : W₁.toAffine.Point) :
    (e.trans f hW₁ hW₂ hW₃).toAddEquiv x = f.toAddEquiv (e.toAddEquiv x) := (rfl)

end RationalPointMap.CurveEquiv

/-- An elliptic cubic with a generator for a cyclic subgroup of order six. -/
structure LevelSixPair (F : Type*) [Field F] [DecidableEq F] where
  curve : WeierstrassCurve F
  elliptic : curve.IsElliptic
  point : curve.toAffine.Point
  order_six : addOrderOf point = 6

namespace LevelSixPair

/-- The cyclic subgroup, independently of the chosen generator. -/
def subgroup (A : LevelSixPair F) : AddSubgroup A.curve.toAffine.Point :=
  AddSubgroup.zmultiples A.point

theorem subgroup_eq (A : LevelSixPair F) :
    A.subgroup = AddSubgroup.zmultiples A.point := (rfl)

/-- A rational origin-preserving isomorphism carrying the marked subgroup.
The generators themselves need not correspond. -/
def Isomorphic (A B : LevelSixPair F) : Prop :=
  ∃ e : RationalPointMap.CurveEquiv A.curve B.curve,
    e.toAddEquiv '' (A.subgroup : Set A.curve.toAffine.Point) = B.subgroup

theorem isomorphic_iff (A B : LevelSixPair F) : A.Isomorphic B ↔
    ∃ e : RationalPointMap.CurveEquiv A.curve B.curve,
      e.toAddEquiv '' (A.subgroup : Set A.curve.toAffine.Point) = B.subgroup :=
  Iff.rfl

theorem isomorphic_refl (A : LevelSixPair F) : A.Isomorphic A := by
  refine ⟨RationalPointMap.CurveEquiv.refl A.curve A.elliptic, ?_⟩
  change id '' (A.subgroup : Set A.curve.toAffine.Point) = _
  exact Set.image_id _

theorem Isomorphic.symm {A B : LevelSixPair F} (h : A.Isomorphic B) :
    B.Isomorphic A := by
  obtain ⟨e, he⟩ := h
  refine ⟨e.symm, ?_⟩
  rw [← he]
  ext x
  simp only [RationalPointMap.CurveEquiv.symm_toAddEquiv, Set.mem_image]
  constructor
  · rintro ⟨y, ⟨z, hz, rfl⟩, hzy⟩
    have hzx : z = x := by simpa only [e.toAddEquiv.symm_apply_apply] using hzy
    exact hzx ▸ hz
  · intro hx
    exact ⟨e.toAddEquiv x, ⟨x, hx, rfl⟩, e.toAddEquiv.symm_apply_apply x⟩

theorem Isomorphic.trans {A B C : LevelSixPair F}
    (hAB : A.Isomorphic B) (hBC : B.Isomorphic C) : A.Isomorphic C := by
  obtain ⟨e, he⟩ := hAB
  obtain ⟨f, hf⟩ := hBC
  refine ⟨e.trans f A.elliptic B.elliptic C.elliptic, ?_⟩
  change (f.toAddEquiv ∘ e.toAddEquiv) '' _ = _
  simpa only [Set.image_image, Function.comp_def] using
    (show f.toAddEquiv '' (e.toAddEquiv '' (A.subgroup : Set A.curve.toAffine.Point)) =
      C.subgroup by rw [he, hf])

instance pairSetoid : Setoid (LevelSixPair F) where
  r := Isomorphic
  iseqv := ⟨isomorphic_refl, Isomorphic.symm, Isomorphic.trans⟩

/-- Geometric cyclic level-six classes, with the choice of generator forgotten. -/
def Moduli (F : Type*) [Field F] [DecidableEq F] [IsAlgClosed F] :=
  Quotient (pairSetoid (F := F))

/-- The geometric marked-pair class of a representative. -/
def moduliClass (A : LevelSixPair F) : Moduli F := Quotient.mk _ A

theorem moduliClass_eq_iff (A B : LevelSixPair F) :
    A.moduliClass = B.moduliClass ↔ A.Isomorphic B :=
  Quotient.eq

/-- Define a function of the geometric class by an invariant function of pairs. -/
def Moduli.lift {T : Sort*} (f : LevelSixPair F → T)
    (h : ∀ A B, A.Isomorphic B → f A = f B) : Moduli F → T :=
  Quotient.lift f h

theorem Moduli.lift_mk {T : Sort*} (f : LevelSixPair F → T)
    (h : ∀ A B, A.Isomorphic B → f A = f B) (A : LevelSixPair F) :
    Moduli.lift f h A.moduliClass = f A := (rfl)

/-- Prove a property of geometric classes on arbitrary representatives. -/
theorem Moduli.inductionOn {P : Moduli F → Prop} (a : Moduli F)
    (h : ∀ A : LevelSixPair F, P A.moduliClass) : P a := Quotient.inductionOn a h

/-- Compare geometric classes using arbitrary representatives. -/
theorem Moduli.inductionOn₂ {P : Moduli F → Moduli F → Prop} (a b : Moduli F)
    (h : ∀ A B : LevelSixPair F, P A.moduliClass B.moduliClass) : P a b :=
  Quotient.inductionOn₂ a b h

/-- A change of generator within the same cyclic subgroup preserves the class. -/
theorem moduliClass_eq_of_subgroup_eq
    (W : WeierstrassCurve F) (hW : W.IsElliptic)
    (P Q : W.toAffine.Point) (hP : addOrderOf P = 6) (hQ : addOrderOf Q = 6)
    (h : AddSubgroup.zmultiples P = AddSubgroup.zmultiples Q) :
    (LevelSixPair.mk W hW P hP).moduliClass =
      (LevelSixPair.mk W hW Q hQ).moduliClass := by
  apply (moduliClass_eq_iff _ _).mpr
  refine ⟨RationalPointMap.CurveEquiv.refl W hW, ?_⟩
  change id '' (AddSubgroup.zmultiples P : Set W.toAffine.Point) =
    (AddSubgroup.zmultiples Q : Set W.toAffine.Point)
  rw [Set.image_id, h]

end LevelSixPair
end SptClassification
