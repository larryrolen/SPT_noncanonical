module

public import SptClassification.QuadraticForms.CMMarkedModel
public import SptClassification.QuadraticForms.TorsionPointDescent

/-!
# A field of definition for the marked CM model

Adjoin the actual coordinates of the transported order-six point to `ℚ(j)`.
Torsion-coordinate algebraicity makes this extension finite. The descended
point maps to the chosen complex marking and has the same exact order.
Descent of the CM endomorphism and good reduction remain separate.
-/

public section

namespace SptClassification.LevelSixForm

variable {D : ℤ} {r : ZMod 12} [Fact (D < 0)] (Q : LevelSixForm D r)

theorem modelSixPoint_ne_zero : Q.modelSixPoint ≠ 0 := by
  intro h
  have ho := Q.modelSixPoint_order
  rw [h, addOrderOf_zero] at ho
  norm_num at ho

/-- The affine coordinates of the actual transported marking. -/
noncomputable def modelSixCoordinates :
    letI := Q.complexCurve_isElliptic
    PointDescent.Coordinates (WeierstrassDescent.model Q.complexCurve) Q.modelSixPoint :=
  letI := Q.complexCurve_isElliptic
  PointDescent.coordinates (WeierstrassDescent.model Q.complexCurve)
    Q.modelSixPoint Q.modelSixPoint_ne_zero

/-- The subfield of `ℂ` obtained by adjoining the selected marking to `ℚ(j)`. -/
noncomputable def markedField :
    letI := Q.complexCurve_isElliptic
    IntermediateField (WeierstrassDescent.invariantField Q.complexCurve) ℂ :=
  letI := Q.complexCurve_isElliptic
  PointDescent.coordinateField Q.modelSixCoordinates.x Q.modelSixCoordinates.y

/-- The marked field is finite over the actual coefficient field. -/
theorem markedField_finiteDimensional :
    letI := Q.complexCurve_isElliptic
    FiniteDimensional (WeierstrassDescent.invariantField Q.complexCurve) Q.markedField := by
  letI := Q.complexCurve_isElliptic
  apply PointDescent.coordinateField_finiteDimensional_of_torsion
    (WeierstrassDescent.model Q.complexCurve) Q.modelSixCoordinates.nonsingular 6
  · norm_num
  · rw [Q.modelSixCoordinates.point_eq]
    exact (Q.modelSixPoint_nsmul_eq_zero 6).mpr (dvd_refl 6)

/-- If the CM invariant is algebraic, this particular marked field is finite
also over `ℚ`. No algebraicity of the original lattice coefficients is assumed. -/
theorem markedField_finiteDimensional_rat
    (hj : letI := Q.complexCurve_isElliptic; IsAlgebraic ℚ Q.complexCurve.j) :
    FiniteDimensional ℚ Q.markedField := by
  letI := Q.complexCurve_isElliptic
  letI := WeierstrassDescent.invariantField_finiteDimensional Q.complexCurve hj
  letI := Q.markedField_finiteDimensional
  exact FiniteDimensional.trans ℚ (WeierstrassDescent.invariantField Q.complexCurve) Q.markedField

/-- The selected point on the prescribed-j equation over its marked field. -/
noncomputable def markedPoint :
    letI := Q.complexCurve_isElliptic
    ((WeierstrassDescent.model Q.complexCurve).toAffine.baseChange Q.markedField).Point :=
  letI := Q.complexCurve_isElliptic
  PointDescent.point (WeierstrassDescent.model Q.complexCurve)
    Q.modelSixCoordinates.nonsingular

/-- Extension to `ℂ` recovers exactly the transported marking. -/
theorem markedPoint_map :
    letI := Q.complexCurve_isElliptic
    letI := Classical.decEq Q.markedField
    WeierstrassCurve.Affine.Point.map
      (W' := (WeierstrassDescent.model Q.complexCurve).toAffine)
      Q.markedField.val Q.markedPoint = Q.modelSixPoint := by
  letI := Q.complexCurve_isElliptic
  letI := Classical.decEq Q.markedField
  exact (PointDescent.map_point (WeierstrassDescent.model Q.complexCurve)
    Q.modelSixCoordinates.nonsingular).trans Q.modelSixCoordinates.point_eq

/-- Exact order six is preserved in the finite field of definition. -/
theorem markedPoint_order :
    letI := Q.complexCurve_isElliptic
    letI := Classical.decEq Q.markedField
    addOrderOf Q.markedPoint = 6 := by
  letI := Q.complexCurve_isElliptic
  letI := Classical.decEq Q.markedField
  exact (PointDescent.point_order (WeierstrassDescent.model Q.complexCurve)
    Q.modelSixCoordinates.nonsingular).trans
      ((congrArg addOrderOf Q.modelSixCoordinates.point_eq).trans Q.modelSixPoint_order)

/-- The actual cyclic-six pair over the field generated by its marking. -/
noncomputable def markedPair :
    letI := Q.complexCurve_isElliptic
    letI := Classical.decEq Q.markedField
    LevelSixPair Q.markedField := by
  letI := Q.complexCurve_isElliptic
  letI := Classical.decEq Q.markedField
  refine ⟨(WeierstrassDescent.model Q.complexCurve).baseChange Q.markedField,
    ?_, Q.markedPoint, Q.markedPoint_order⟩
  change ((WeierstrassDescent.model Q.complexCurve).map
    (algebraMap (WeierstrassDescent.invariantField Q.complexCurve) Q.markedField)).IsElliptic
  infer_instance

end SptClassification.LevelSixForm
