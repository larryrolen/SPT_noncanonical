module

public import SptClassification.QuadraticForms.CMKernelSeparation
public import SptClassification.QuadraticForms.LevelSixModuli

/-!
# Separation of specialized CM moduli classes

An injective specialization of the actual cyclic CM subgroup supplies a
geometric level-six class. Compatible opposite CM orientations give different
classes under the manuscript bound, for ordinary and supersingular primes.
Construction of these specializations and their eta-coordinate compatibility
remain separate from this deduction.
-/

public section

namespace SptClassification.LevelSixForm

variable {D : ℤ} {r s : ZMod 12} [Fact (D < 0)] (Q : LevelSixForm D r)

/-- The image of a cyclic CM subgroup is generated by the specialized point. -/
theorem specialization_range
    {G : Type*} [AddCommGroup G] (e : Q.curveLevelSix →+ G) :
    Set.range e = (AddSubgroup.zmultiples (e Q.levelPoint) : Set G) := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    have hx : (x : Q.complexCurve.toAffine.Point) ∈
        AddSubgroup.zmultiples Q.curveSixPoint := by
      simpa only [Q.curveLevelSix_eq] using x.property
    obtain ⟨k, hk⟩ := hx
    refine ⟨k, ?_⟩
    change k • e Q.levelPoint = e x
    rw [← map_zsmul]
    apply congrArg e
    apply Subtype.ext
    change k • (Q.levelPoint : Q.complexCurve.toAffine.Point) = _
    rw [Q.levelPoint_val]
    exact hk
  · rintro ⟨k, rfl⟩
    exact ⟨k • Q.levelPoint, map_zsmul e k Q.levelPoint⟩

/-- The actual marked special fiber represented with its specialized generator. -/
noncomputable def specializedPair
    {F : Type*} [Field F] [DecidableEq F]
    (W : WeierstrassCurve F) (hW : W.IsElliptic)
    (e : Q.curveLevelSix →+ W.toAffine.Point) (he : Function.Injective e) :
    LevelSixPair F :=
  ⟨W, hW, e Q.levelPoint, Q.specialized_levelPoint_order e he⟩

/-- A marked-pair class cannot be shared by compatible opposite-orientation
CM reductions under the strict separation bound. No splitting hypothesis is
required; the underlying kernel bound retains its named literature premises. -/
theorem specialized_moduli_ne_of_bound
    (R : LevelSixForm D s) (hQ : Q.b % 2 = 1) (hR : R.b % 2 = 1)
    (n : ℕ) (hn : 4 * (n : ℤ) = 1 - D)
    {F : Type*} [Field F] [DecidableEq F] [IsAlgClosed F]
    (p : ℕ) [Fact p.Prime] [CharP F p] (hp : 3 < p)
    (hbound : (1 - D) ^ 2 < 24 * (p : ℤ))
    (W₁ W₂ : WeierstrassCurve F) (hW₁ : W₁.IsElliptic) (hW₂ : W₂.IsElliptic)
    (σQ : RationalPointMap.endomorphismRing Q.complexCurve →+*
      RationalPointMap.endomorphismRing W₁)
    (σR : RationalPointMap.endomorphismRing R.complexCurve →+*
      RationalPointMap.endomorphismRing W₂)
    (eQ : Q.curveLevelSix →+ W₁.toAffine.Point)
    (eR : R.curveLevelSix →+ W₂.toAffine.Point)
    (heQ : Function.Injective eQ) (heR : Function.Injective eR)
    (hequivQ : ∀ x, RationalPointMap.pointAction W₁ (σQ (Q.rationalGenerator hQ))
      (eQ x) = eQ (Q.levelGenerator hQ x))
    (hequivR : ∀ x, RationalPointMap.pointAction W₂ (σR (R.rationalGenerator hR))
      (eR x) = eR (R.levelGenerator hR x))
    (hr : r = 1 ∨ r = 11) (hs : s = 5 ∨ s = 7) :
    (Q.specializedPair W₁ hW₁ eQ heQ).moduliClass ≠
      (R.specializedPair W₂ hW₂ eR heR).moduliClass := by
  intro heq
  simp only [specializedPair] at heq
  obtain ⟨φ, hφ⟩ := (LevelSixPair.isomorphic_iff _ _).mp
    ((LevelSixPair.moduliClass_eq_iff _ _).mp heq.symm)
  simp only [LevelSixPair.subgroup_eq] at hφ
  apply Q.not_rational_pair_specializations_of_bound R hQ hR n hn p hp hbound
    W₁ W₂ hW₁ hW₂ σQ σR eQ eR heQ φ _ hequivQ hequivR hr hs
  rw [Q.specialization_range, R.specialization_range]
  exact hφ.symm

end SptClassification.LevelSixForm
