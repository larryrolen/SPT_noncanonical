namespace SptClassification.RationalPointMap

/-- [rolen2026canonical, Lemma 5.2, p. 8], with reduced norms expressed as
geometric kernel cardinalities of separable isogenies. The norm is isogeny
degree [silverman2009, Chapter III, §6; Chapter V, §3]. The factor hypotheses
make both isogenies separable: a factor of prime-to-`p` multiplication is
separable. Trivial geometric `p`-torsion is the supersingularity criterion
[silverman2009, Chapter V, §3]. The normalization is exactly `6p ≤ 4N(f)N(g)`.
This general literature estimate has no CM or splitting hypothesis. -/
theorem supersingular_kernel_bound
    {F : Type*} [Field F] [DecidableEq F] [IsAlgClosed F]
    (p : ℕ) [Fact p.Prime] [CharP F p] (hp : 3 < p)
    (W : WeierstrassCurve F) (hW : W.IsElliptic)
    (hss : ∀ P : W.toAffine.Point, p • P = 0 → P = 0)
    (P : W.toAffine.Point) (hP : addOrderOf P = 6)
    (f g : endomorphismRing W)
    (hf : HasPrimeToCharFactor p W f) (hg : HasPrimeToCharFactor p W g)
    (hfC : ∀ x ∈ AddSubgroup.zmultiples P,
      pointAction W f x ∈ AddSubgroup.zmultiples P)
    (hgC : ∀ x ∈ AddSubgroup.zmultiples P,
      pointAction W g x ∈ AddSubgroup.zmultiples P)
    (hne : f * g ≠ g * f) :
    6 * p ≤ 4 * kernelCard W f * kernelCard W g := by
  sorry

end SptClassification.RationalPointMap
